# Exclude credentials and local environments
.env
.env.*
!.env.example
*.key
*.pem
*.json_credentials

# Exclude virtual environments and python artifacts
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Exclude source control and local agent configurations
.git/
.agents/
.agent/
_agents/
_agent/
.taste-skill/

# Exclude test files from final image
tests/

# Exclude IDE and build caches
.idea/
.vscode/
node_modules/
dist/
build/
frontend/node_modules/
