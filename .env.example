# Environment Configuration for LARA Runtime
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Sessions
SECRET_KEY=lara-prototype-secret-key-change-in-production-min32chars
SESSION_COOKIE_NAME=lara_session
SESSION_MAX_AGE_SECONDS=86400
COOKIE_SECURE=false
DEMO_PASSWORD=demo-password

# Google Cloud Target Configuration
# Project: lara-runtime-ashwath-2026
# Region: asia-south1
GOOGLE_CLOUD_PROJECT=lara-runtime-ashwath-2026
FIRESTORE_DATABASE=(default)
GCS_BUCKET=lara-runtime-ashwath-2026-assets
VERTEX_AI_LOCATION=asia-south1
VERTEX_AI_MODEL=gemini-2.5-flash

# Set to true in live GCP deployment to use real Cloud services
LARA_USE_LIVE_FIRESTORE=false
LARA_USE_LIVE_VERTEX_AI=false

# goboxd Execution Sandbox VM Configuration
GOBOXD_BASE_URL=http://localhost:8081
GOBOXD_INTERNAL_AUTH_TOKEN=dev-internal-token-goboxd
GOBOXD_TIMEOUT_SECONDS=15.0
GOBOXD_KILL_SWITCH=false
SANDBOX_MAX_WALL_TIME_S=10
SANDBOX_MAX_MEMORY_KB=1048576
SANDBOX_MAX_PROCESSES=100
