# ==============================================================================
# LARA Runtime Environment Configuration
# ==============================================================================

# Core Environment
# Options: development | test | production
# In production, missing GCP variables or weak SECRET_KEY will cause startup to FAIL CLOSED.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Security & Sessions
# In production: SECRET_KEY must be a cryptographically random string (min 32 chars) from Secret Manager.
SECRET_KEY=lara-prototype-secret-key-change-in-production-min32chars
SESSION_COOKIE_NAME=lara_session
SESSION_MAX_AGE_SECONDS=86400
COOKIE_SECURE=false
DEMO_PASSWORD=demo-password

# ==============================================================================
# Google Cloud Platform Configuration (User-Scoped Staging)
# ==============================================================================
# Required in production; leave blank for local offline development.
# Do NOT hardcode personal or developer project IDs. Must be explicitly supplied by deployer.
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
GCS_BUCKET=

# Vertex AI Model Configuration
# Note: gemini-2.5-flash was retired October 20, 2026.
# Recommended candidate: gemini-3.8-flash.
# Supported serving locations: global (default for lowest latency/broadest quota), or regional asia-northeast1.
# Before deploying to production, project owner must confirm data residency constraints.
VERTEX_AI_LOCATION=global
VERTEX_AI_MODEL=gemini-3.8-flash

# Substrate Mode Flags
# Set to true ONLY in deployed Cloud Run / GCP environment with valid ADC credentials.
LARA_USE_LIVE_FIRESTORE=false
LARA_USE_LIVE_VERTEX_AI=false

# ==============================================================================
# goboxd Isolated Sandbox VM Configuration
# ==============================================================================
# In production: GOBOXD_BASE_URL must point to the private RFC1918 internal IP of the GCE VM.
# Plain HTTP over VPC does NOT provide application-layer encryption; configure TLS/mTLS before activation.
GOBOXD_BASE_URL=http://localhost:8081
GOBOXD_INTERNAL_AUTH_TOKEN=
GOBOXD_TIMEOUT_SECONDS=15.0
# MUST remain true until the private GCE VM is provisioned, authenticated, and verified.
GOBOXD_KILL_SWITCH=true

# Sandbox Kernel Limits
SANDBOX_MAX_WALL_TIME_S=10
SANDBOX_MAX_MEMORY_KB=1048576
SANDBOX_MAX_PROCESSES=100
