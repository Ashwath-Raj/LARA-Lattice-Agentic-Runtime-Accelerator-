# Configuration only. Never put credentials or API keys here.
GOOGLE_CLOUD_PROJECT=<project-id>
GOOGLE_CLOUD_LOCATION=<verified-vertex-location>
VERTEX_GEMINI_MODEL=<verified-model-id>
FIRESTORE_DATABASE=(default)
GCS_BUCKET=<private-bucket-name>
APP_ENV=development
DEMO_MODE=true
SESSION_COOKIE_SECURE=false
SESSION_TTL_MINUTES=240
GRAPH_CACHE_TTL_SECONDS=30
GRAPH_MAX_NODES=250
GRAPH_MAX_EDGES=800
