c,MAAM,GAAK;;;;iBAC7B;;;;;;OACJ;;;;;MACF;QA1DG,KAAK;;;;YA0DR,CACL,EACI;;;;aACF;;;;;;GACJ;;;;WACF;;;;;;EAEL,oDAAC,qCAAD;GACE,QAAQ;GACR,eAAe,eAAe,KAAK;GACnC,UAAU;GACI;EACf;;;;;CACE;;;;;AAET","names":[],"ignoreList":[],"sources":["WorkbenchHome.tsx"],"sourcesContent":["import React, { useState, useEffect } from 'react';\nimport { Task, TaskCreate } from '../../api/types';\nimport { api } from '../../api/client';\nimport { useAuth } from '../auth/AuthContext';\nimport { NewTaskModal } from './NewTaskModal';\nimport { TaskDetailView } from './TaskDetailView';\nimport {\n  Plus,\n  Play,\n  Activity,\n  CheckCircle2,\n  Clock,\n  Database,\n  Cpu,\n  Layers,\n  ArrowUpRight,\n} from 'lucide-react';\n\ninterface WorkbenchHomeProps {\n  onNavigateToHighways: () => void;\n  onNavigateToApprovals: () => void;\n}\n\nexport const WorkbenchHome: React.FC<WorkbenchHomeProps> = ({\n  onNavigateToHighways,\n  onNavigateToApprovals,\n}) => {\n  const { principal, versionChangeNonce } = useAuth();\n  const [tasks, setTasks] = useState<Task[]>([]);\n  const [selectedTask, setSelectedTask] = useState<Task | null>(null);\n  const [isModalOpen, setIsModalOpen] = useState(false);\n  const [isSubmitting, setIsSubmitting] = useState(false);\n\n  useEffect(() => {\n    api.getRecentTasks().then((list) => {\n      setTasks(list);\n    });\n  }, [versionChangeNonce]);\n\n  const handleCreateTask = async (data: TaskCreate) => {\n    setIsSubmitting(true);\n    try {\n      const accepted = await api.createTask(data);\n      const fullTask = await api.getTask(accepted.task_id);\n      setTasks((prev) => [fullTask, ...prev]);\n      setSelectedTask(fullTask);\n    } finally {\n      setIsSubmitting(false);\n    }\n  };\n\n  const handleSelectTask = async (taskId: string) => {\n    const t = await api.getTask(taskId);\n    setSelectedTask(t);\n  };\n\n  if (selectedTask) {\n    return (\n      <TaskDetailView\n        task={selectedTask}\n        onBack={() => setSelectedTask(null)}\n        onNavigateToHighways={onNavigateToHighways}\n        onNavigateToApprovals={onNavigateToApprovals}\n      />\n    );\n  }\n\n  return (\n    <div>\n      {/* Hero row with Primary CTA */}\n      <div\n        className=\"lara-panel\"\n        style={{\n          background: 'linear-gradient(135deg, #FFFFFF 0%, var(--lara-surface-subtle) 100%)',\n          marginBottom: '28px',\n          display: 'flex',\n          alignItems: 'center',\n          justifyContent: 'space-between',\n          flexWrap: 'wrap',\n          gap: '24px',\n        }}\n      >\n        <div style={{ maxWidth: '640px' }}>\n          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '8px' }}>\n            <span className=\"lara-badge lara-badge--routing\">DYNAMIC ROUTING RUNTIME</span>\n            <span className=\"lara-badge lara-badge--allow\">HEALTHY</span>\n          </div>\n          <h1 style={{ margin: '0 0 10px', fontSize: '28px', fontWeight: 900, letterSpacing: '-0.02em' }}>\n            Enterprise Incident Workbench\n          </h1>\n          <p style={{ margin: 0, fontSize: '15px', color: 'var(--lara-muted)', lineHeight: 1.5 }}>\n            LARA dynamically constructs authorised Information Highways across enterprise telemetry, operating procedures, and specialist agents for each task.\n          </p>\n        </div>\n\n        <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n          <button\n            onClick={() => setIsModalOpen(true)}\n            className=\"lara-button lara-button--primary\"\n            style={{ padding: '12px 24px', fontSize: '15px' }}\n          >\n            <Plus size={18} />\n            Start Investigation\n          </button>\n        </div>\n      </div>\n\n      {/* System Status Indicators */}\n      <div\n        style={{\n          display: 'grid',\n          gridTemplateColumns: 'repeat(auto-fit, minmax(240px, 1fr))',\n          gap: '16px',\n          marginBottom: '28px',\n        }}\n      >\n        <div className=\"lara-panel lara-panel--sm\" style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n          <div style={{ background: '#E8F9F0', padding: '10px', borderRadius: '12px', color: '#0E7741' }}>\n            <Database size={20} />\n          </div>\n          <div>\n            <div style={{ fontSize: '11px', color: 'var(--lara-muted)', fontWeight: 700, textTransform: 'uppercase' }}>\n              Persistence Store\n            </div>\n            <div style={{ fontSize: '14px', fontWeight: 800 }}>Firestore Native Mode</div>\n            <div style={{ fontSize: '11px', color: 'var(--lara-green)', fontWeight: 600 }}>Canonical Nodes &amp; Edges</div>\n          </div>\n        </div>\n\n        <div className=\"lara-panel lara-panel--sm\" style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n          <div style={{ background: '#EEF0FF', padding: '10px', borderRadius: '12px', color: 'var(--lara-blue)' }}>\n            <Cpu size={20} />\n          </div>\n          <div>\n            <div style={{ fontSize: '11px', color: 'var(--lara-muted)', fontWeight: 700, textTransform: 'uppercase' }}>\n              Model Inference\n            </div>\n            <div style={{ fontSize: '14px', fontWeight: 800 }}>Vertex AI Gemini 2.0</div>\n            <div style={{ fontSize: '11px', color: 'var(--lara-blue)', fontWeight: 600 }}>Provider Adapter (ADC Auth)</div>\n          </div>\n        </div>\n\n        <div className=\"lara-panel lara-panel--sm\" style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n          <div style={{ background: '#E2F7FC', padding: '10px', borderRadius: '12px', color: '#027A9B' }}>\n            <Layers size={20} />\n          </div>\n          <div>\n            <div style={{ fontSize: '11px', color: 'var(--lara-muted)', fontWeight: 700, textTransform: 'uppercase' }}>\n              Routing Engine\n            </div>\n            <div style={{ fontSize: '14px', fontWeight: 800 }}>Dynamic Highways</div>\n            <div style={{ fontSize: '11px', color: '#027A9B', fontWeight: 600 }}>Role &amp; Context Filtered</div>\n          </div>\n        </div>\n\n        <div className=\"lara-panel lara-panel--sm\" style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n          <div style={{ background: 'var(--lara-lime)', padding: '10px', borderRadius: '12px', color: '#283800' }}>\n            <Activity size={20} />\n          </div>\n          <div>\n            <div style={{ fontSize: '11px', color: 'var(--lara-muted)', fontWeight: 700, textTransform: 'uppercase' }}>\n              Active Session\n            </div>\n            <div style={{ fontSize: '14px', fontWeight: 800 }}>{principal.display_name}</div>\n            <div style={{ fontSize: '11px', color: '#283800', fontWeight: 600 }}>\n              Role: <strong>{principal.roles[0]}</strong> ({principal.attributes.clearance})\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Recent Investigations Table */}\n      <div className=\"lara-panel\">\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '16px' }}>\n          <div>\n            <h2 style={{ margin: 0, fontSize: '18px', fontWeight: 800 }}>Recent Investigations</h2>\n            <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n              Tasks processed through LARA orchestrator and specialist agent pipeline\n            </div>\n          </div>\n\n          <button\n            onClick={() => setIsModalOpen(true)}\n            className=\"lara-button lara-button--secondary lara-button--sm\"\n          >\n            <Play size={14} />\n            New Run\n          </button>\n        </div>\n\n        <div style={{ overflowX: 'auto' }}>\n          <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '13px' }}>\n            <thead>\n              <tr style={{ borderBottom: '2px solid var(--lara-line)', textAlign: 'left', color: 'var(--lara-muted)' }}>\n                <th style={{ padding: '10px 12px' }}>Investigation</th>\n                <th style={{ padding: '10px 12px' }}>Incident ID</th>\n                <th style={{ padding: '10px 12px' }}>Status</th>\n                <th style={{ padding: '10px 12px' }}>Current Stage</th>\n                <th style={{ padding: '10px 12px' }}>Principal</th>\n                <th style={{ padding: '10px 12px' }}>Created</th>\n                <th style={{ padding: '10px 12px', textAlign: 'right' }}>Action</th>\n              </tr>\n            </thead>\n            <tbody>\n              {tasks.map((task) => (\n                <tr\n                  key={task.task_id}\n                  onClick={() => handleSelectTask(task.task_id)}\n                  style={{\n                    borderBottom: '1px solid var(--lara-line)',\n                    cursor: 'pointer',\n                    transition: 'background 0.1s ease',\n                  }}\n                  onMouseEnter={(e) => (e.currentTarget.style.backgroundColor = 'var(--lara-surface-subtle)')}\n                  onMouseLeave={(e) => (e.currentTarget.style.backgroundColor = 'transparent')}\n                >\n                  <td style={{ padding: '12px', fontWeight: 700 }}>\n                    <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n                      <span>{task.title}</span>\n                      <span className=\"lara-badge lara-badge--synthetic\" style={{ fontSize: '9px' }}>\n                        SYNTHETIC\n                      </span>\n                    </div>\n                  </td>\n                  <td style={{ padding: '12px' }}>\n                    <code>{task.incident_id || 'N/A'}</code>\n                  </td>\n                  <td style={{ padding: '12px' }}>\n                    {task.status === 'COMPLETED' ? (\n                      <span className=\"lara-badge lara-badge--allow\">\n                        <CheckCircle2 size={12} /> COMPLETED\n                      </span>\n                    ) : task.status === 'AWAITING_APPROVAL' ? (\n                      <span className=\"lara-badge lara-badge--review\">\n                        <Clock size={12} /> AWAITING APPROVAL\n                      </span>\n                    ) : (\n                      <span className=\"lara-badge lara-badge--routing\">{task.status}</span>\n                    )}\n                  </td>\n                  <td style={{ padding: '12px' }}>\n                    <span style={{ fontSize: '12px', color: 'var(--lara-muted)', fontWeight: 600 }}>\n                      {task.current_stage}\n                    </span>\n                  </td>\n                  <td style={{ padding: '12px', color: 'var(--lara-ink)' }}>\n                    <code>{task.principal_id}</code>\n                  </td>\n                  <td style={{ padding: '12px', color: 'var(--lara-muted)' }}>\n                    {new Date(task.created_at).toLocaleTimeString()}\n                  </td>\n                  <td style={{ padding: '12px', textAlign: 'right' }}>\n                    <span\n                      style={{\n                        display: 'inline-flex',\n                        alignItems: 'center',\n                        gap: '4px',\n                        color: 'var(--lara-blue)',\n                        fontWeight: 700,\n                      }}\n                    >\n                      Inspect <ArrowUpRight size={14} />\n                    </span>\n                  </td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      </div>\n\n      <NewTaskModal\n        isOpen={isModalOpen}\n        onClose={() => setIsModalOpen(false)}\n        onSubmit={handleCreateTask}\n        isSubmitting={isSubmitting}\n      />\n    </div>\n  );\n};\n"],"file":"/src/features/workbench/WorkbenchHome.tsx"}