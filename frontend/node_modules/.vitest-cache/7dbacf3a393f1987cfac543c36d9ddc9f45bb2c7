eEffect } from 'react';\nimport { GraphNode, GraphEdge, RouteResult } from '../../api/types';\nimport { api } from '../../api/client';\nimport { useAuth } from '../auth/AuthContext';\nimport {\n  GitBranch,\n  ShieldAlert,\n  Database,\n  Cpu,\n  Wrench,\n  CheckCircle2,\n  Table,\n  Eye,\n  Info,\n} from 'lucide-react';\n\nexport const HighwayGraphView: React.FC = () => {\n  const { principal, versionChangeNonce } = useAuth();\n  const [nodes, setNodes] = useState<GraphNode[]>([]);\n  const [edges, setEdges] = useState<GraphEdge[]>([]);\n  const [route, setRoute] = useState<RouteResult | null>(null);\n  const [selectedNode, setSelectedNode] = useState<GraphNode | null>(null);\n  const [viewMode, setViewMode] = useState<'canvas' | 'table'>('canvas');\n  const [isLoading, setIsLoading] = useState(true);\n\n  useEffect(() => {\n    setIsLoading(true);\n    Promise.all([api.getGraphNodes(), api.getGraphEdges(), api.resolveRoute('task_demo_inc204')])\n      .then(([n, e, r]) => {\n        setNodes(n);\n        setEdges(e);\n        setRoute(r);\n        setSelectedNode(n[0] || null);\n      })\n      .finally(() => {\n        setIsLoading(false);\n      });\n  }, [versionChangeNonce]);\n\n  // Coordinates mapping for layout columns\n  // Col 0: Sources (x: 60)\n  // Col 1: Workflow (x: 320)\n  // Col 2: Agents (x: 580)\n  // Col 3: Tools (x: 840)\n  const getNodePosition = (nodeId: string, index: number, totalInCol: number) => {\n    let col = 0;\n    if (nodeId.startsWith('source:')) col = 0;\n    else if (nodeId.startsWith('workflow:')) col = 1;\n    else if (nodeId.startsWith('agent:')) col = 2;\n    else if (nodeId.startsWith('tool:')) col = 3;\n\n    const x = col === 0 ? 80 : col === 1 ? 320 : col === 2 ? 580 : 840;\n    const spacing = 480 / (totalInCol + 1);\n    const y = 60 + (index + 1) * spacing;\n    return { x, y };\n  };\n\n  const sources = nodes.filter((n) => n.node_id.startsWith('source:'));\n  const workflows = nodes.filter((n) => n.node_id.startsWith('workflow:'));\n  const agents = nodes.filter((n) => n.node_id.startsWith('agent:'));\n  const tools = nodes.filter((n) => n.node_id.startsWith('tool:'));\n\n  const getNodeCoords = (nodeId: string) => {\n    if (nodeId.startsWith('source:')) {\n      const idx = sources.findIndex((s) => s.node_id === nodeId);\n      return getNodePosition(nodeId, idx >= 0 ? idx : 0, sources.length);\n    }\n    if (nodeId.startsWith('workflow:')) {\n      const idx = workflows.findIndex((s) => s.node_id === nodeId);\n      return getNodePosition(nodeId, idx >= 0 ? idx : 0, workflows.length);\n    }\n    if (nodeId.startsWith('agent:')) {\n      const idx = agents.findIndex((s) => s.node_id === nodeId);\n      return getNodePosition(nodeId, idx >= 0 ? idx : 0, agents.length);\n    }\n    const idx = tools.findIndex((s) => s.node_id === nodeId);\n    return getNodePosition(nodeId, idx >= 0 ? idx : 0, tools.length);\n  };\n\n  const isNodeSelectedInRoute = (nodeId: string) => {\n    return route?.selected_path?.includes(nodeId) || false;\n  };\n\n  const isEdgeInRoute = (src: string, tgt: string) => {\n    return isNodeSelectedInRoute(src) && isNodeSelectedInRoute(tgt);\n  };\n\n  const getNodeBadgeColor = (type: string) => {\n    switch (type) {\n      case 'source': return 'var(--lara-lilac)';\n      case 'workflow': return 'var(--lara-blue)';\n      case 'agent': return '#C7B9FF';\n      case 'tool': return 'var(--lara-orange)';\n      default: return 'var(--lara-ink)';\n    }\n  };\n\n  const getNodeIcon = (type: string) => {\n    switch (type) {\n      case 'source': return <Database size={14} />;\n      case 'agent': return <Cpu size={14} />;\n      case 'tool': return <Wrench size={14} />;\n      default: return <GitBranch size={14} />;\n    }\n  };\n\n  return (\n    <div>\n      {/* Header and Controls */}\n      <div className=\"lara-panel\" style={{ marginBottom: '24px' }}>\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n          <div>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n              <span className=\"lara-badge lara-badge--routing\">INFORMATION HIGHWAYS CONSOLE</span>\n              <span className=\"lara-badge lara-badge--neutral\">GRAPH VERSION: {route?.graph_version || 4}</span>\n            </div>\n            <h1 style={{ margin: 0, fontSize: '24px', fontWeight: 900 }}>\n              Dynamic Task Route Resolution\n            </h1>\n            <p style={{ margin: '4px 0 0', fontSize: '14px', color: 'var(--lara-muted)' }}>\n              Resolved route for principal <strong>{principal.display_name}</strong> ({principal.roles[0]} &bull; {principal.attributes.clearance}).\n            </p>\n          </div>\n\n          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n            <button\n              onClick={() => setViewMode(viewMode === 'canvas' ? 'table' : 'canvas')}\n              className=\"lara-button lara-button--secondary lara-button--sm\"\n            >\n              {viewMode === 'canvas' ? <Table size={14} /> : <Eye size={14} />}\n              {viewMode === 'canvas' ? 'Show Accessible Table' : 'Show Interactive Graph'}\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {isLoading ? (\n        <div className=\"lara-panel\" style={{ padding: '48px', textAlign: 'center', color: 'var(--lara-muted)' }}>\n          Resolving Information Highway routes across Firestore graph...\n        </div>\n      ) : viewMode === 'table' ? (\n        /* Accessible Table Fallback */\n        <div className=\"lara-panel\">\n          <h3 style={{ margin: '0 0 16px', fontSize: '16px', fontWeight: 800 }}>\n            Authorised Nodes for Session Principal: {principal.display_name}\n          </h3>\n          <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '13px' }}>\n            <thead>\n              <tr style={{ borderBottom: '2px solid var(--lara-line)', textAlign: 'left', color: 'var(--lara-muted)' }}>\n                <th style={{ padding: '10px 12px' }}>Node ID</th>\n                <th style={{ padding: '10px 12px' }}>Type</th>\n                <th style={{ padding: '10px 12px' }}>Name</th>\n                <th style={{ padding: '10px 12px' }}>Classification</th>\n                <th style={{ padding: '10px 12px' }}>Highway Status</th>\n                <th style={{ padding: '10px 12px' }}>Trust Score</th>\n              </tr>\n            </thead>\n            <tbody>\n              {nodes.map((n) => {\n                const inRoute = isNodeSelectedInRoute(n.node_id);\n                return (\n                  <tr key={n.node_id} style={{ borderBottom: '1px solid var(--lara-line)' }}>\n                    <td style={{ padding: '10px 12px', fontWeight: 600 }}><code>{n.node_id}</code></td>\n                    <td style={{ padding: '10px 12px' }}>\n                      <span className=\"lara-badge lara-badge--neutral\">{n.type}</span>\n                    </td>\n                    <td style={{ padding: '10px 12px' }}>{n.name}</td>\n                    <td style={{ padding: '10px 12px' }}>\n                      <span className=\"lara-badge lara-badge--neutral\">{n.classification}</span>\n                    </td>\n                    <td style={{ padding: '10px 12px' }}>\n                      {inRoute ? (\n                        <span className=\"lara-badge lara-badge--routing\">SELECTED HIGHWAY</span>\n                      ) : (\n                        <span className=\"lara-badge lara-badge--neutral\">UNSELECTED</span>\n                      )}\n                    </td>\n                    <td style={{ padding: '10px 12px' }}>{Math.round(n.trust_score * 100)}%</td>\n                  </tr>\n                );\n              })}\n            </tbody>\n          </table>\n        </div>\n      ) : (\n        /* Interactive Visual Graph Canvas & Explanation Panel */\n        <div style={{ display: 'grid', gridTemplateColumns: '1fr 340px', gap: '24px' }}>\n          {/* SVG Graph Canvas */}\n          <div\n            className=\"lara-panel\"\n            style={{\n              padding: '16px',\n              overflow: 'hidden',\n              background: '#FFFFFF',\n              position: 'relative',\n              borderRadius: 'var(--lara-radius-md)',\n            }}\n          >\n            {/* Column labels */}\n            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(4, 1fr)', textAlign: 'center', marginBottom: '12px', fontSize: '11px', fontWeight: 800, color: 'var(--lara-muted)', textTransform: 'uppercase', letterSpacing: '0.05em' }}>\n              <div>Authorised Sources</div>\n              <div>Workflow Context</div>\n              <div>Specialist Agents</div>\n              <div>Tools &amp; Actuators</div>\n            </div>\n\n            <svg\n              viewBox=\"0 0 1020 540\"\n              style={{ width: '100%', height: 'auto', display: 'block', minHeight: '520px' }}\n            >\n              <defs>\n                <marker\n                  id=\"arrow-cyan\"\n                  viewBox=\"0 0 10 10\"\n                  refX=\"18\"\n                  refY=\"5\"\n                  markerWidth=\"6\"\n                  markerHeight=\"6\"\n                  orient=\"auto-start-reverse\"\n                >\n                  <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#00B9E8\" />\n                </marker>\n                <marker\n                  id=\"arrow-faint\"\n                  viewBox=\"0 0 10 10\"\n                  refX=\"18\"\n                  refY=\"5\"\n                  markerWidth=\"5\"\n                  markerHeight=\"5\"\n                  orient=\"auto-start-reverse\"\n                >\n                  <path d=\"M 0 0 L 10 5 L 0 10 z\" fill=\"#D8E0CE\" />\n                </marker>\n              </defs>\n\n              {/* Render Edge Connectors */}\n              {edges.map((e) => {\n                const srcCoords = getNodeCoords(e.source_node);\n                const tgtCoords = getNodeCoords(e.target_node);\n                const isSelected = isEdgeInRoute(e.source_node, e.target_node);\n\n                const dx = tgtCoords.x - srcCoords.x;\n                const cp1x = srcCoords.x + dx * 0.5;\n                const cp1y = srcCoords.y;\n                const cp2x = srcCoords.x + dx * 0.5;\n                const cp2y = tgtCoords.y;\n\n                const pathData = `M ${srcCoords.x} ${srcCoords.y} C ${cp1x} ${cp1y}, ${cp2x} ${cp2y}, ${tgtCoords.x} ${tgtCoords.y}`;\n\n                return (\n                  <path\n                    key={e.edge_id}\n                    d={pathData}\n                    fill=\"none\"\n                    stroke={isSelected ? '#00B9E8' : '#D8E0CE'}\n                    strokeWidth={isSelected ? 4 : 1.5}\n                    strokeDasharray={isSelected ? 'none' : '4,4'}\n                    markerEnd={isSelected ? 'url(#arrow-cyan)' : 'url(#arrow-faint)'}\n                    style={{ transition: 'stroke 0.2s ease, stroke-width 0.2s ease' }}\n                  />\n                );\n              })}\n\n              {/* Render Nodes */}\n              {nodes.map((node) => {\n                const coords = getNodeCoords(node.node_id);\n                const isSelected = isNodeSelectedInRoute(node.node_id);\n                const isFocused = selectedNode?.node_id === node.node_id;\n\n                return (\n                  <g\n                    key={node.node_id}\n                    transform={`translate(${coords.x - 70}, ${coords.y - 28})`}\n                    onClick={() => setSelectedNode(node)}\n                    style={{ cursor: 'pointer' }}\n                  >\n                    {/* Node background card */}\n                    <rect\n                      width=\"140\"\n                      height=\"56\"\n                      rx=\"16\"\n                      fill={isFocused ? '#E4FF88' : isSelected ? '#FFFFFF' : '#F8FAF2'}\n                      stroke={\n                        isFocused\n                          ? '#101014'\n                          : isSelected\n                          ? '#00B9E8'\n                          : '#D8E0CE'\n                      }\n                      strokeWidth={isSelected ? 3 : 1.5}\n                      filter=\"drop-shadow(0 4px 10px rgba(16,16,20,0.06))\"\n                    />\n\n                    {/* Node color accent dot */}\n                    <circle\n                      cx=\"18\"\n                      cy=\"18\"\n                      r=\"6\"\n                      fill={getNodeBadgeColor(node.type)}\n                    />\n\n                    {/* Node Title */}\n                    <text\n                      x=\"30\"\n                      y=\"22\"\n                      fontFamily=\"Inter, sans-serif\"\n                      fontSize=\"11\"\n                      fontWeight=\"800\"\n                      fill=\"#101014\"\n                    >\n                      {node.name.length > 15 ? `${node.name.substring(0, 14)}…` : node.name}\n                    </text>\n\n                    {/* Node Type and classification */}\n                    <text\n                      x=\"30\"\n                      y=\"38\"\n                      fontFamily=\"Inter, sans-serif\"\n                      fontSize=\"9\"\n                      fontWeight=\"600\"\n                      fill=\"#66666F\"\n                    >\n                      {node.type.toUpperCase()} &bull; {node.classification}\n                    </text>\n                  </g>\n                );\n              })}\n            </svg>\n          </div>\n\n          {/* Route Explanation & Node Details Panel */}\n          <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>\n            {/* Route Score & Quality Factors */}\n            <div className=\"lara-panel lara-panel--sm\">\n              <h3 style={{ margin: '0 0 10px', fontSize: '15px', fontWeight: 800 }}>\n                Highway Quality Scores\n              </h3>\n              {route?.score_components && (\n                <div style={{ display: 'flex', flexDirection: 'column', gap: '8px', fontSize: '12px' }}>\n                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n                    <span style={{ color: 'var(--lara-muted)' }}>Relevance:</span>\n                    <strong>{Math.round(route.score_components.relevance * 100)}%</strong>\n                  </div>\n                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n                    <span style={{ color: 'var(--lara-muted)' }}>Trust Score:</span>\n                    <strong>{Math.round(route.score_components.trust * 100)}%</strong>\n                  </div>\n                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n                    <span style={{ color: 'var(--lara-muted)' }}>Data Freshness:</span>\n                    <strong>{Math.round(route.score_components.freshness * 100)}%</strong>\n                  </div>\n                  <div style={{ display: 'flex', justifyContent: 'space-between' }}>\n                    <span style={{ color: 'var(--lara-muted)' }}>Availability:</span>\n                    <strong>{Math.round(route.score_components.availability * 100)}%</strong>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Excluded Candidates & Security Filter */}\n            {route?.excluded_candidates && route.excluded_candidates.length > 0 && (\n              <div\n                className=\"lara-panel lara-panel--sm\"\n                style={{ background: '#FFF0EB', borderColor: '#FFD2C0' }}\n              >\n                <div style={{ display: 'flex', alignItems: 'center', gap: '6px', marginBottom: '8px', color: '#B53A0A', fontWeight: 800, fontSize: '13px' }}>\n                  <ShieldAlert size={16} />\n                  Excluded Paths (Policy Denied)\n                </div>\n                <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>\n                  {route.excluded_candidates.map((exc, i) => (\n                    <div\n                      key={i}\n                      style={{\n                        padding: '6px 10px',\n                        background: 'rgba(255,255,255,0.7)',\n                        borderRadius: 'var(--lara-radius-sm)',\n                        fontSize: '11px',\n                        lineHeight: 1.4,\n                      }}\n                    >\n                      <span className=\"lara-badge lara-badge--deny\" style={{ fontSize: '9px', padding: '1px 6px', marginRight: '6px' }}>\n                        {exc.reason_code}\n                      </span>\n                      {exc.display}\n                    </div>\n                  ))}\n                </div>\n              </div>\n            )}\n\n            {/* Selected Node Inspector */}\n            {selectedNode ? (\n              <div className=\"lara-panel lara-panel--sm\">\n                <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '8px' }}>\n                  <div style={{ background: getNodeBadgeColor(selectedNode.type), padding: '6px', borderRadius: '8px' }}>\n                    {getNodeIcon(selectedNode.type)}\n                  </div>\n                  <div>\n                    <h4 style={{ margin: 0, fontSize: '14px', fontWeight: 800 }}>{selectedNode.name}</h4>\n                    <span style={{ fontSize: '10px', color: 'var(--lara-muted)' }}><code>{selectedNode.node_id}</code></span>\n                  </div>\n                </div>\n\n                <div style={{ fontSize: '12px', lineHeight: 1.5, color: 'var(--lara-ink)', marginBottom: '12px' }}>\n                  {selectedNode.description || 'No description provided.'}\n                </div>\n\n                <div style={{ display: 'flex', flexDirection: 'column', gap: '6px', fontSize: '11px', paddingTop: '8px', borderTop: '1px solid var(--lara-line)' }}>\n                  <div><strong>Classification:</strong> {selectedNode.classification}</div>\n                  <div><strong>Allowed Roles:</strong> {selectedNode.allowed_roles.join(', ')}</div>\n                  <div><strong>Trust Score:</strong> {Math.round(selectedNode.trust_score * 100)}%</div>\n                  {selectedNode.source_uri && (\n                    <div style={{ wordBreak: 'break-all' }}>\n                      <strong>Source URI:</strong> <code>{selectedNode.source_uri}</code>\n                    </div>\n                  )}\n                </div>\n              </div>\n            ) : (\n              <div className=\"lara-panel lara-panel--sm\" style={{ color: 'var(--lara-muted)', fontSize: '12px', textAlign: 'center', padding: '24px' }}>\n                <Info size={18} style={{ margin: '0 auto 6px', display: 'block' }} />\n                Click on any node in the graph to inspect metadata.\n              </div>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"],"file":"/src/features/highways/HighwayGraphView.tsx"}