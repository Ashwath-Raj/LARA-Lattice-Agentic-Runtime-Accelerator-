 className={`badge badge-${tone}`}>{dot && <i/>}{children}</span>;\n}\nexport function StatusBadge({ status }: { status: string }) {\n  const s = status.toLowerCase();\n  const tone = s.includes('resolved') || s.includes('healthy') || s.includes('verified') || s.includes('approved') || s.includes('promoted') ? 'green' : s.includes('critical') || s.includes('blocked') || s.includes('failed') || s.includes('denied') ? 'red' : s.includes('awaiting') || s.includes('review') || s.includes('stale') || s.includes('candidate') ? 'amber' : s.includes('active') || s.includes('investigating') || s.includes('current') ? 'blue' : 'neutral';\n  return <Badge tone={tone} dot>{status}</Badge>;\n}\nexport function EnvironmentBadge() { return <span className=\"environment-badge\"><span/> SYNTHETIC DEMO ENVIRONMENT</span>; }\nexport function TextField({ label, value, onChange, placeholder, type = 'text', hint }: { label?: string; value?: string; onChange?: (v:string)=>void; placeholder?: string; type?: string; hint?: string }) {\n  return <label className=\"field\">{label && <span className=\"field-label\">{label}</span>}<input value={value} onChange={e=>onChange?.(e.target.value)} type={type} placeholder={placeholder}/>{hint && <small>{hint}</small>}</label>;\n}\nexport function SearchField({ value, onChange, placeholder = 'Search' }: { value:string; onChange:(v:string)=>void; placeholder?:string }) {\n  return <div className=\"search-field\"><Search size={16}/><input value={value} onChange={e=>onChange(e.target.value)} placeholder={placeholder}/>{value && <button aria-label=\"Clear search\" onClick={()=>onChange('')}><X size={14}/></button>}</div>;\n}\nexport function SelectField({ label, value, onChange, options }: { label?:string; value:string; onChange:(v:string)=>void; options:string[] }) {\n  return <label className=\"field\">{label && <span className=\"field-label\">{label}</span>}<select value={value} onChange={e=>onChange(e.target.value)}>{options.map(o=><option key={o}>{o}</option>)}</select></label>;\n}\nexport function FilterChip({ children, active = false, onClick }: React.PropsWithChildren<{ active?:boolean; onClick?:()=>void }>) { return <button type=\"button\" onClick={onClick} className={`filter-chip ${active?'active':''}`}>{children}<ChevronDown size={13}/></button>; }\nexport function Tabs({ items, value, onChange }: { items:string[]; value:string; onChange:(v:string)=>void }) { return <div className=\"tabs\" role=\"tablist\">{items.map(x=><button key={x} role=\"tab\" aria-selected={value===x} className={value===x?'selected':''} onClick={()=>onChange(x)}>{x}</button>)}</div>; }\nexport function Panel({ title, subtitle, action, children, className = '' }: React.PropsWithChildren<{ title?:string; subtitle?:string; action?:React.ReactNode; className?:string }>) { return <section className={`panel ${className}`}>{(title||action) && <div className=\"panel-head\"><div>{title && <h3>{title}</h3>}{subtitle && <p>{subtitle}</p>}</div>{action}</div>}{children}</section>; }\nexport function PageHeader({ eyebrow, title, subtitle, actions }: { eyebrow?:string; title:string; subtitle?:string; actions?:React.ReactNode }) { return <div className=\"page-header\"><div>{eyebrow && <div className=\"eyebrow\">{eyebrow}</div>}<h1>{title}</h1>{subtitle && <p>{subtitle}</p>}</div>{actions && <div className=\"page-actions\">{actions}</div>}</div>; }\nexport function MetricCard({ label, value, change, icon, tone='blue' }: { label:string; value:string; change?:string; icon?:React.ReactNode; tone?:'blue'|'green'|'amber'|'purple' }) { return <div className={`metric-card metric-${tone}`}><div className=\"metric-top\"><span>{label}</span>{icon && <span className=\"metric-icon\">{icon}</span>}</div><div className=\"metric-value\">{value}</div>{change && <div className=\"metric-change\">{change}</div>}</div>; }\nexport function EmptyState({ title, description, action }: { title:string; description:string; action?:React.ReactNode }) { return <div className=\"empty-state\"><div className=\"empty-icon\">◇</div><h3>{title}</h3><p>{description}</p>{action}</div>; }\nexport function InlineAlert({ tone='info', title, children }: React.PropsWithChildren<{ tone?:'info'|'warning'|'danger'|'success'; title?:string }>) { return <div className={`inline-alert alert-${tone}`}><div><strong>{title}</strong>{children && <p>{children}</p>}</div></div>; }\nexport function Avatar({ name, size='md' }: { name:string; size?:'sm'|'md'|'lg' }) { const initials = name.split(' ').filter(Boolean).slice(0,2).map(n=>n[0]).join('').toUpperCase(); return <span className={`avatar avatar-${size}`} aria-label={name}>{initials}</span>; }\nexport function ProgressBar({ value, label }: { value:number; label?:string }) { return <div className=\"progress-wrap\">{label && <div className=\"progress-label\"><span>{label}</span><strong>{value}%</strong></div>}<div className=\"progress-track\"><span style={{width:`${Math.max(0,Math.min(100,value))}%`}}/></div></div>; }\nexport function Modal({ open, title, description, onClose, children, footer }: React.PropsWithChildren<{ open:boolean; title:string; description?:string; onClose:()=>void; footer?:React.ReactNode }>) { if (!open) return null; return <div className=\"modal-backdrop\" role=\"presentation\" onMouseDown={e=>{if(e.target===e.currentTarget)onClose();}}><section className=\"modal\" role=\"dialog\" aria-modal=\"true\" aria-label={title}><div className=\"modal-head\"><div><h2>{title}</h2>{description && <p>{description}</p>}</div><IconButton label=\"Close dialog\" onClick={onClose}><X size={18}/></IconButton></div><div className=\"modal-body\">{children}</div>{footer && <div className=\"modal-foot\">{footer}</div>}</section></div>; }\nexport function Drawer({ open, title, onClose, children }: React.PropsWithChildren<{ open:boolean; title:string; onClose:()=>void }>) { if(!open)return null; return <div className=\"drawer-backdrop\" onMouseDown={e=>{if(e.target===e.currentTarget)onClose();}}><aside className=\"drawer\"><div className=\"drawer-head\"><h2>{title}</h2><IconButton label=\"Close drawer\" onClick={onClose}><X size={18}/></IconButton></div>{children}</aside></div>; }\nexport function CopyButton({ text }: { text:string }) { const [copied,setCopied]=useState(false); return <button className=\"copy-button\" onClick={()=>{void navigator.clipboard?.writeText(text);setCopied(true);window.setTimeout(()=>setCopied(false),1200);}}>{copied?<Check size={13}/>:<Copy size={13}/>} {copied?'Copied':'Copy'}</button>; }\nexport function JsonViewer({ value }: { value:unknown }) { const str = useMemo(()=>JSON.stringify(value,null,2),[value]); return <pre className=\"json-viewer\"><code>{str}</code><span className=\"json-copy\"><CopyButton text={str}/></span></pre>; }\nexport function DataTable<T extends Record<string, unknown>>({ columns, rows, rowKey, onRowClick, empty = 'No records found' }: { columns:{key:keyof T;label:string;render?:(row:T)=>React.ReactNode; width?:string}[]; rows:T[]; rowKey:keyof T; onRowClick?:(row:T)=>void; empty?:string }) {\n  const [sort,setSort]=useState<string>(''); const [direction,setDirection]=useState<'asc'|'desc'>('asc'); const sorted = useMemo(()=>{if(!sort)return rows;return [...rows].sort((a,b)=>String(a[sort]??'').localeCompare(String(b[sort]??''))*(direction==='asc'?1:-1));},[rows,sort,direction]);\n  return <div className=\"table-scroll\"><table className=\"data-table\"><thead><tr>{columns.map(c=><th key={String(c.key)} style={{width:c.width}}><button onClick={()=>{if(sort===String(c.key))setDirection(direction==='asc'?'desc':'asc');else{setSort(String(c.key));setDirection('asc');}}}>{c.label}{sort===String(c.key) ? (direction==='asc'?' ↑':' ↓') : ''}</button></th>)}</tr></thead><tbody>{sorted.length===0?<tr><td colSpan={columns.length} className=\"table-empty\">{empty}</td></tr>:sorted.map(row=><tr key={String(row[rowKey])} onClick={()=>onRowClick?.(row)} className={onRowClick?'clickable-row':''}>{columns.map(c=><td key={String(c.key)}>{c.render?c.render(row):String(row[c.key]??'—')}</td>)}</tr>)}</tbody></table></div>;\n}\nexport function Pagination({ page, total, pageSize, onChange }: { page:number; total:number; pageSize:number; onChange:(p:number)=>void }) { const pages=Math.max(1,Math.ceil(total/pageSize)); return <div className=\"pagination\"><span>{total===0?'0':`${(page-1)*pageSize+1}–${Math.min(page*pageSize,total)} of ${total}`}</span><div><button disabled={page<=1} onClick={()=>onChange(page-1)} aria-label=\"Previous page\"><ChevronLeft size={16}/></button><button disabled={page>=pages} onClick={()=>onChange(page+1)} aria-label=\"Next page\"><ChevronRight size={16}/></button></div></div>; }\nexport function Timeline({ items }: { items:{time:string;title:string;detail:string;status?:string}[] }) { return <ol className=\"timeline\">{items.map((item,i)=><li key={`${item.time}-${i}`}><span className=\"timeline-dot\"/><div><div className=\"timeline-line\"><strong>{item.title}</strong><time>{item.time}</time></div><p>{item.detail}</p>{item.status && <StatusBadge status={item.status}/>}</div></li>)}</ol>; }\nexport function SectionTitle({ title, caption, action }: { title:string; caption?:string; action?:React.ReactNode }) { return <div className=\"section-title\"><div><h2>{title}</h2>{caption && <p>{caption}</p>}</div>{action}</div>; }\n\nexport function Checkbox({ label, checked, onChange }: { label:string; checked:boolean; onChange:(v:boolean)=>void }) { return <label className=\"choice-control\"><input type=\"checkbox\" checked={checked} onChange={e=>onChange(e.target.checked)}/><span>{label}</span></label>; }\nexport function Switch({ label, checked, onChange }: { label:string; checked:boolean; onChange:(v:boolean)=>void }) { return <label className=\"switch-control\"><span>{label}</span><input type=\"checkbox\" role=\"switch\" checked={checked} onChange={e=>onChange(e.target.checked)}/><i/></label>; }\nexport function RadioGroup({ label, options, value, onChange }: { label:string; options:string[]; value:string; onChange:(v:string)=>void }) { return <fieldset className=\"radio-group\"><legend>{label}</legend>{options.map(o=><label key={o}><input type=\"radio\" name={label} checked={value===o} onChange={()=>onChange(o)}/>{o}</label>)}</fieldset>; }\nexport function SegmentedControl({ options, value, onChange }: { options:string[]; value:string; onChange:(v:string)=>void }) { return <div className=\"segmented-control\">{options.map(o=><button key={o} className={o===value?'active':''} onClick={()=>onChange(o)}>{o}</button>)}</div>; }\nexport function Tooltip({ label, children }: React.PropsWithChildren<{label:string}>) { return <span className=\"tooltip-wrap\" tabIndex={0}>{children}<span role=\"tooltip\">{label}</span></span>; }\nexport function DropdownMenu({ label, items, onSelect }: { label:string; items:string[]; onSelect:(item:string)=>void }) { const [open,setOpen]=useState(false); return <div className=\"dropdown-wrap\"><button className=\"btn\" onClick={()=>setOpen(v=>!v)}>{label}<ChevronDown size={14}/></button>{open&&<div className=\"dropdown-content\">{items.map(item=><button key={item} onClick={()=>{onSelect(item);setOpen(false);}}>{item}</button>)}</div>}</div>; }\nexport function Skeleton({ width='100%', height='12px' }: {width?:string;height?:string}) { return <span className=\"skeleton\" style={{width,height}}/>; }\nexport function LoadingState({ label='Loading data' }: {label?:string}) { return <div className=\"loading-state\"><span className=\"spinner\"/><span>{label}</span></div>; }\nexport function ErrorState({ title='Unable to load this view', detail='Check the connection and try again.' }: {title?:string;detail?:string}) { return <div className=\"error-state\"><strong>{title}</strong><p>{detail}</p></div>; }\nexport function TrendIndicator({ value, positive=true }: {value:string;positive?:boolean}) { return <span className={`trend-indicator ${positive?'positive':'negative'}`}>{positive?'↑':'↓'} {value}</span>; }\nexport function Sparkline({ values, label='Trend' }: {values:number[];label?:string}) { const max=Math.max(...values,1),min=Math.min(...values),span=max-min||1; const points=values.map((v,i)=>`${(i/(Math.max(values.length-1,1)))*100},${36-((v-min)/span)*31}`).join(' '); return <svg className=\"sparkline\" viewBox=\"0 0 100 40\" role=\"img\" aria-label={label}><polyline points={points} fill=\"none\" stroke=\"#1A73E8\" strokeWidth=\"2\" strokeLinecap=\"round\" strokeLinejoin=\"round\"/></svg>; }\nexport function Stepper({ steps, active }: {steps:string[];active:number}) { return <div className=\"mini-stepper\">{steps.map((s,i)=><div key={s} className={i<active?'complete':i===active?'active':''}><span>{i<active?'✓':i+1}</span><small>{s}</small></div>)}</div>; }\nexport function CodeBlock({ code, language='text' }: {code:string;language?:string}) { return <div className=\"code-block\"><div>{language}</div><pre><code>{code}</code></pre></div>; }\n\nexport function CountBadge({ count }: {count:number|string}) { return <span className=\"count-badge\">{count}</span>; }\nexport function RoleBadge({ role }: {role:string}) { return <Badge tone={role.toLowerCase().includes('admin')?'purple':role.toLowerCase().includes('supervisor')?'amber':'blue'}>{role}</Badge>; }\nexport function AvatarGroup({ names }: {names:string[]}) { return <span className=\"avatar-group\">{names.slice(0,4).map(n=><Avatar key={n} name={n} size=\"sm\"/>)}{names.length>4&&<span className=\"avatar-overflow\">+{names.length-4}</span>}</span>; }\nexport function TextArea({ label, value, onChange, placeholder, rows=4 }: {label:string;value:string;onChange:(v:string)=>void;placeholder?:string;rows?:number}) { return <label className=\"field\"><span className=\"field-label\">{label}</span><textarea rows={rows} value={value} onChange={e=>onChange(e.target.value)} placeholder={placeholder}/></label>; }\nexport function Combobox({ label, value, onChange, options }: {label:string;value:string;onChange:(v:string)=>void;options:string[]}) { const id=`combo-${label.toLowerCase().replace(/[^a-z0-9]+/g,'-')}`; return <label className=\"field\"><span className=\"field-label\">{label}</span><input list={id} value={value} onChange={e=>onChange(e.target.value)} className=\"combo-input\"/><datalist id={id}>{options.map(o=><option key={o} value={o}/>)}</datalist></label>; }\nexport function DateRangePicker({ label='Date range', value, onChange }: {label?:string;value:string;onChange:(v:string)=>void}) { return <label className=\"field\"><span className=\"field-label\">{label}</span><select value={value} onChange={e=>onChange(e.target.value)}><option>Last 7 days</option><option>Last 30 days</option><option>Last 90 days</option><option>Custom range</option></select></label>; }\nexport function Callout({ tone='info', title, children }: React.PropsWithChildren<{tone?:'info'|'warning'|'danger'|'success';title:string}>) { return <div className={`inline-alert alert-${tone}`}><div><strong>{title}</strong><p>{children}</p></div></div>; }\nexport function ConfirmDialog({ open, title, description, confirmLabel='Confirm', onCancel, onConfirm, destructive=false }: {open:boolean;title:string;description:string;confirmLabel?:string;onCancel:()=>void;onConfirm:()=>void;destructive?:boolean}) { return <Modal open={open} title={title} description={description} onClose={onCancel} footer={<><Button onClick={onCancel}>Cancel</Button><Button variant={destructive?'danger':'primary'} onClick={onConfirm}>{confirmLabel}</Button></>}/>; }\nexport function Toast({ message, tone='success', onDismiss }: {message:string;tone?:'success'|'warning'|'error';onDismiss:()=>void}) { return <div className={`toast toast-${tone}`} role=\"status\"><span>{message}</span><button onClick={onDismiss} aria-label=\"Dismiss\">×</button></div>; }\n"],"file":"/src/components/ui/index.tsx"}