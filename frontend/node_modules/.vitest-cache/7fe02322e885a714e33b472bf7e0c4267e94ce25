t":["import React, { useState, useEffect } from 'react';\nimport { EvolutionProposal } from '../../api/types';\nimport { api } from '../../api/client';\nimport { useAuth } from '../auth/AuthContext';\nimport {\n  Sparkles,\n  ShieldCheck,\n  CheckCircle2,\n  XCircle,\n  Play,\n  RotateCcw,\n  AlertTriangle,\n  Lock,\n} from 'lucide-react';\n\nexport const EvolutionLabView: React.FC = () => {\n  const { principal, versionChangeNonce } = useAuth();\n  const [proposals, setProposals] = useState<EvolutionProposal[]>([]);\n  const [selectedProposal, setSelectedProposal] = useState<EvolutionProposal | null>(null);\n  const [isEvaluating, setIsEvaluating] = useState(false);\n  const [isPromoting, setIsPromoting] = useState(false);\n  const [approvalReason, setApprovalReason] = useState('Candidate passed the required functional and security suite.');\n  const [feedbackMsg, setFeedbackMsg] = useState<{ text: string; type: 'success' | 'error' } | null>(null);\n\n  const isAdmin = principal.roles.includes('runtime_admin');\n\n  useEffect(() => {\n    api.getEvolutionProposals().then((list) => {\n      setProposals(list);\n      if (list.length > 0) {\n        setSelectedProposal(list[0]);\n      }\n    });\n  }, [versionChangeNonce]);\n\n  const handleRunEvaluation = async () => {\n    if (!selectedProposal) return;\n    setIsEvaluating(true);\n    setFeedbackMsg(null);\n    try {\n      const updated = await api.evaluateCandidate(selectedProposal.proposal_id);\n      setSelectedProposal(updated);\n      setFeedbackMsg({ text: 'Evaluation suite passed! All functional cases and security invariants verified.', type: 'success' });\n    } catch (err: unknown) {\n      setFeedbackMsg({ text: err instanceof Error ? err.message : 'Evaluation failed', type: 'error' });\n    } finally {\n      setIsEvaluating(false);\n    }\n  };\n\n  const handleApprovePromotion = async () => {\n    if (!selectedProposal) return;\n    if (!isAdmin) {\n      setFeedbackMsg({ text: 'Access Denied: Only Runtime Administrator can approve candidate evolution models.', type: 'error' });\n      return;\n    }\n    setIsPromoting(true);\n    setFeedbackMsg(null);\n    try {\n      const updated = await api.approveCandidate(selectedProposal.proposal_id, approvalReason);\n      setSelectedProposal(updated);\n      setFeedbackMsg({ text: `Candidate ${updated.candidate_version} promoted to active production!`, type: 'success' });\n    } catch (err: unknown) {\n      setFeedbackMsg({ text: err instanceof Error ? err.message : 'Promotion failed', type: 'error' });\n    } finally {\n      setIsPromoting(false);\n    }\n  };\n\n  const handleRollback = async () => {\n    if (!selectedProposal) return;\n    if (!isAdmin) {\n      setFeedbackMsg({ text: 'Access Denied: Only Runtime Administrator can rollback prompt versions.', type: 'error' });\n      return;\n    }\n    try {\n      const updated = await api.rollbackCandidate(selectedProposal.proposal_id, 'Rollback to baseline version');\n      setSelectedProposal(updated);\n      setFeedbackMsg({ text: `Rolled back to parent version ${updated.parent_version}.`, type: 'success' });\n    } catch (err: unknown) {\n      setFeedbackMsg({ text: err instanceof Error ? err.message : 'Rollback failed', type: 'error' });\n    }\n  };\n\n  return (\n    <div>\n      {/* Top Banner */}\n      <div className=\"lara-panel\" style={{ marginBottom: '24px' }}>\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n          <div>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n              <span className=\"lara-badge lara-badge--evolution\">CONTROLLED EVOLUTION LAB</span>\n              <span className=\"lara-badge lara-badge--neutral\">GOVERNANCE GATEWAY ACTIVE</span>\n            </div>\n            <h1 style={{ margin: 0, fontSize: '24px', fontWeight: 900 }}>Prompt &amp; Skill Evolution Engine</h1>\n            <p style={{ margin: '4px 0 0', fontSize: '14px', color: 'var(--lara-muted)' }}>\n              Adapts specialist agent instructions based on observed execution failure signals under strict immutable evaluation gates.\n            </p>\n          </div>\n\n          <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n            {isAdmin ? (\n              <span className=\"lara-badge lara-badge--allow\" style={{ padding: '6px 14px' }}>\n                <ShieldCheck size={14} /> ADMINISTRATOR APPROVAL AUTHORISED\n              </span>\n            ) : (\n              <span className=\"lara-badge lara-badge--neutral\" style={{ padding: '6px 14px' }}>\n                <Lock size={14} /> READ-ONLY (SWITCH TO RUNTIME ADMIN TO PROMOTE)\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {feedbackMsg && (\n        <div\n          style={{\n            padding: '12px 16px',\n            borderRadius: 'var(--lara-radius-sm)',\n            marginBottom: '20px',\n            fontSize: '13px',\n            fontWeight: 700,\n            background: feedbackMsg.type === 'success' ? '#E4F9EE' : '#FFF0EB',\n            color: feedbackMsg.type === 'success' ? '#0E7741' : '#B53A0A',\n            border: feedbackMsg.type === 'success' ? '1px solid #B2F0CF' : '1px solid #FFD2C0',\n          }}\n        >\n          {feedbackMsg.text}\n        </div>\n      )}\n\n      {selectedProposal && (\n        <div style={{ display: 'grid', gridTemplateColumns: '1fr', gap: '24px' }}>\n          {/* Failure Signal & Diagnosis Card */}\n          <div className=\"lara-panel\" style={{ borderLeft: '6px solid var(--lara-violet)' }}>\n            <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px', marginBottom: '14px' }}>\n              <div>\n                <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n                  <span className=\"lara-badge lara-badge--evolution\">PROPOSAL: {selectedProposal.proposal_id}</span>\n                  <span className=\"lara-badge lara-badge--neutral\">TARGET: {selectedProposal.target_id}</span>\n                  <span\n                    className={`lara-badge ${\n                      selectedProposal.status === 'PROMOTED'\n                        ? 'lara-badge--allow'\n                        : selectedProposal.status === 'ROLLED_BACK'\n                        ? 'lara-badge--deny'\n                        : 'lara-badge--review'\n                    }`}\n                  >\n                    STATUS: {selectedProposal.status}\n                  </span>\n                </div>\n                <h2 style={{ margin: '0 0 6px', fontSize: '20px', fontWeight: 800 }}>\n                  Observed Failure Signal: {selectedProposal.failure_summary}\n                </h2>\n                <div style={{ fontSize: '13px', color: 'var(--lara-ink)' }}>\n                  Trigger Trace: <code>{selectedProposal.trigger_trace_ids.join(', ')}</code>\n                </div>\n              </div>\n\n              <div style={{ textAlign: 'right', fontSize: '12px', color: 'var(--lara-muted)' }}>\n                <div>Parent Version: <strong>v{selectedProposal.parent_version}</strong></div>\n                <div>Candidate Version: <strong>v{selectedProposal.candidate_version}</strong></div>\n              </div>\n            </div>\n\n            <div\n              style={{\n                background: 'var(--lara-surface-subtle)',\n                padding: '12px 16px',\n                borderRadius: 'var(--lara-radius-sm)',\n                border: '1px solid var(--lara-line)',\n                fontSize: '13px',\n                lineHeight: 1.5,\n              }}\n            >\n              <strong>Diagnosed Remediation:</strong> {selectedProposal.change_summary}\n            </div>\n          </div>\n\n          {/* Prompt Diff Viewer */}\n          <div className=\"lara-panel\">\n            <h3 style={{ margin: '0 0 16px', fontSize: '16px', fontWeight: 800 }}>\n              Prompt Candidate Diff Inspection\n            </h3>\n\n            <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '16px' }}>\n              <div>\n                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>\n                  <span style={{ fontSize: '12px', fontWeight: 800, color: 'var(--lara-muted)', textTransform: 'uppercase' }}>\n                    Active Baseline (v{selectedProposal.parent_version})\n                  </span>\n                  <span className=\"lara-badge lara-badge--neutral\" style={{ fontSize: '10px' }}>\n                    CURRENT IN PRODUCTION\n                  </span>\n                </div>\n                <pre\n                  style={{\n                    background: '#F8FAF2',\n                    padding: '16px',\n                    borderRadius: 'var(--lara-radius-sm)',\n                    border: '1px solid var(--lara-line)',\n                    fontFamily: 'var(--lara-font-mono)',\n                    fontSize: '12px',\n                    whiteSpace: 'pre-wrap',\n                    wordBreak: 'break-word',\n                    color: '#44444A',\n                    minHeight: '160px',\n                    margin: 0,\n                  }}\n                >\n                  {selectedProposal.parent_content}\n                </pre>\n              </div>\n\n              <div>\n                <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>\n                  <span style={{ fontSize: '12px', fontWeight: 800, color: 'var(--lara-violet)', textTransform: 'uppercase' }}>\n                    Candidate Version (v{selectedProposal.candidate_version})\n                  </span>\n                  <span className=\"lara-badge lara-badge--evolution\" style={{ fontSize: '10px' }}>\n                    EVALUATION TARGET\n                  </span>\n                </div>\n                <pre\n                  style={{\n                    background: '#F8F4FF',\n                    padding: '16px',\n                    borderRadius: 'var(--lara-radius-sm)',\n                    border: '1.5px solid var(--lara-violet)',\n                    fontFamily: 'var(--lara-font-mono)',\n                    fontSize: '12px',\n                    whiteSpace: 'pre-wrap',\n                    wordBreak: 'break-word',\n                    color: '#21104A',\n                    minHeight: '160px',\n                    margin: 0,\n                  }}\n                >\n                  {selectedProposal.candidate_content}\n                </pre>\n              </div>\n            </div>\n          </div>\n\n          {/* Evaluation Harness & Test Suite */}\n          <div className=\"lara-panel\">\n            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '16px' }}>\n              <div>\n                <h3 style={{ margin: 0, fontSize: '16px', fontWeight: 800 }}>\n                  Fixed Evaluation Suite (Functional &amp; Security Invariants)\n                </h3>\n                <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n                  Evaluates 2 functional cases and 4 immutable security regression invariants.\n                </div>\n              </div>\n\n              <button\n                onClick={handleRunEvaluation}\n                disabled={isEvaluating}\n                className=\"lara-button lara-button--secondary lara-button--sm\"\n              >\n                <Play size={14} color=\"var(--lara-violet)\" />\n                {isEvaluating ? 'Executing Tests...' : 'Run Evaluation Suite'}\n              </button>\n            </div>\n\n            <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '13px' }}>\n              <thead>\n                <tr style={{ borderBottom: '2px solid var(--lara-line)', textAlign: 'left', color: 'var(--lara-muted)' }}>\n                  <th style={{ padding: '8px 12px' }}>Case ID</th>\n                  <th style={{ padding: '8px 12px' }}>Category</th>\n                  <th style={{ padding: '8px 12px' }}>Input Test Vector</th>\n                  <th style={{ padding: '8px 12px' }}>Expected Invariant</th>\n                  <th style={{ padding: '8px 12px' }}>Result Status</th>\n                </tr>\n              </thead>\n              <tbody>\n                {selectedProposal.evaluation_results.map((c) => (\n                  <tr key={c.case_id} style={{ borderBottom: '1px solid var(--lara-line)' }}>\n                    <td style={{ padding: '10px 12px', fontWeight: 700 }}><code>{c.case_id}</code></td>\n                    <td style={{ padding: '10px 12px' }}>\n                      <span className=\"lara-badge lara-badge--neutral\" style={{ textTransform: 'capitalize' }}>\n                        {c.category}\n                      </span>\n                    </td>\n                    <td style={{ padding: '10px 12px' }}>{c.input}</td>\n                    <td style={{ padding: '10px 12px', color: 'var(--lara-muted)' }}>{c.expected}</td>\n                    <td style={{ padding: '10px 12px' }}>\n                      {c.status === 'PASSED' ? (\n                        <span className=\"lara-badge lara-badge--allow\" style={{ fontSize: '11px' }}>\n                          <CheckCircle2 size={12} /> PASSED\n                        </span>\n                      ) : (\n                        <span className=\"lara-badge lara-badge--deny\" style={{ fontSize: '11px' }}>\n                          <XCircle size={12} /> FAILED\n                        </span>\n                      )}\n                    </td>\n                  </tr>\n                ))}\n              </tbody>\n            </table>\n          </div>\n\n          {/* Admin Promotion Controls */}\n          <div\n            className=\"lara-panel\"\n            style={{\n              background: isAdmin ? 'var(--lara-surface-subtle)' : '#FAFAFA',\n              border: isAdmin ? '2px solid var(--lara-violet)' : '1px solid var(--lara-line)',\n            }}\n          >\n            <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n              <div style={{ maxWidth: '640px' }}>\n                <h3 style={{ margin: '0 0 6px', fontSize: '16px', fontWeight: 800 }}>\n                  Administrator Promotion Gateway\n                </h3>\n                <p style={{ margin: '0 0 12px', fontSize: '13px', color: 'var(--lara-muted)', lineHeight: 1.4 }}>\n                  Self-evolution requires human-in-the-loop signoff. Autonomous promotion of prompt modifications is strictly forbidden.\n                </p>\n\n                {isAdmin ? (\n                  <div style={{ marginBottom: '12px' }}>\n                    <label className=\"lara-label\">Mandatory Approval Justification Reason</label>\n                    <input\n                      type=\"text\"\n                      className=\"lara-input\"\n                      value={approvalReason}\n                      onChange={(e) => setApprovalReason(e.target.value)}\n                      placeholder=\"Enter justification reason (min 8 chars)...\"\n                    />\n                  </div>\n                ) : (\n                  <div style={{ display: 'flex', alignItems: 'center', gap: '8px', color: 'var(--lara-orange)', fontSize: '13px', fontWeight: 700 }}>\n                    <AlertTriangle size={16} />\n                    Current session ({principal.roles[0]}) is not authorised to promote evolution candidates.\n                  </div>\n                )}\n              </div>\n\n              <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n                {selectedProposal.status === 'PROMOTED' && (\n                  <button\n                    onClick={handleRollback}\n                    disabled={!isAdmin}\n                    className=\"lara-button lara-button--secondary\"\n                  >\n                    <RotateCcw size={16} />\n                    Rollback to v{selectedProposal.parent_version}\n                  </button>\n                )}\n\n                <button\n                  onClick={handleApprovePromotion}\n                  disabled={!isAdmin || isPromoting || selectedProposal.status === 'PROMOTED'}\n                  className=\"lara-button lara-button--primary\"\n                  style={{ background: 'var(--lara-violet)' }}\n                >\n                  <Sparkles size={16} />\n                  {isPromoting\n                    ? 'Promoting...'\n                    : selectedProposal.status === 'PROMOTED'\n                    ? 'Candidate Already Promoted'\n                    : 'Approve & Promote Candidate'}\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"],"file":"/src/features/evolution/EvolutionLabView.tsx"}