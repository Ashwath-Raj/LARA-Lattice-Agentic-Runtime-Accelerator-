purpose });\n      setDecision(res);\n    } finally {\n      setIsEvaluating(false);\n    }\n  };\n\n  const getDecisionBadge = (dec: string) => {\n    switch (dec) {\n      case 'ALLOW':\n        return <span className=\"lara-badge lara-badge--allow\">ALLOW</span>;\n      case 'DENY':\n        return <span className=\"lara-badge lara-badge--deny\">DENY</span>;\n      case 'REQUIRE_APPROVAL':\n        return <span className=\"lara-badge lara-badge--review\">REQUIRE APPROVAL</span>;\n      case 'REDACT':\n        return <span className=\"lara-badge lara-badge--authority\">REDACT</span>;\n      default:\n        return <span className=\"lara-badge lara-badge--neutral\">{dec}</span>;\n    }\n  };\n\n  return (\n    <div>\n      <div className=\"lara-panel\" style={{ marginBottom: '24px' }}>\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n          <div>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n              <span className=\"lara-badge lara-badge--authority\">IDENTITY &amp; GOVERNANCE CONSOLE</span>\n              <span className=\"lara-badge lara-badge--neutral\">FAIL-CLOSED ENFORCEMENT</span>\n            </div>\n            <h1 style={{ margin: 0, fontSize: '24px', fontWeight: 900 }}>RBAC &amp; ABAC Policy Authority</h1>\n            <p style={{ margin: '4px 0 0', fontSize: '14px', color: 'var(--lara-muted)' }}>\n              Backend is authoritative. Identity, attributes, and access decisions are evaluated strictly server-side.\n            </p>\n          </div>\n          <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n            Active Session: <strong>{principal.display_name}</strong>\n          </div>\n        </div>\n      </div>\n\n      <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '24px' }}>\n        {/* Seeded Demo Principals Directory */}\n        <div className=\"lara-panel\">\n          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '16px' }}>\n            <UserCheck size={18} color=\"var(--lara-blue)\" />\n            <h3 style={{ margin: 0, fontSize: '16px', fontWeight: 800 }}>Seeded Demo Principals</h3>\n          </div>\n\n          <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>\n            {allPrincipals.map((p) => {\n              const isCurrent = p.principal_id === principal.principal_id;\n              return (\n                <div\n                  key={p.principal_id}\n                  style={{\n                    padding: '12px',\n                    borderRadius: 'var(--lara-radius-sm)',\n                    background: isCurrent ? 'var(--lara-surface-subtle)' : '#FFFFFF',\n                    border: isCurrent ? '1.5px solid var(--lara-blue)' : '1px solid var(--lara-line)',\n                  }}\n                >\n                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '4px' }}>\n                    <strong style={{ fontSize: '14px' }}>{p.display_name}</strong>\n                    {isCurrent && (\n                      <span className=\"lara-badge lara-badge--routing\" style={{ fontSize: '10px' }}>\n                        ACTIVE SESSION\n                      </span>\n                    )}\n                  </div>\n                  <div style={{ fontSize: '12px', color: 'var(--lara-muted)', marginBottom: '6px' }}>\n                    <code>{p.principal_id}</code> &bull; Role: <strong>{p.roles[0]}</strong>\n                  </div>\n                  <div style={{ display: 'flex', gap: '6px', fontSize: '11px', flexWrap: 'wrap' }}>\n                    <span className=\"lara-badge lara-badge--neutral\">Dept: {p.attributes.department}</span>\n                    <span className=\"lara-badge lara-badge--neutral\">Clearance: {p.attributes.clearance}</span>\n                    <span className=\"lara-badge lara-badge--neutral\">Project: {p.attributes.project}</span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Policy Decision Simulator */}\n        <div className=\"lara-panel\">\n          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '16px' }}>\n            <ShieldCheck size={18} color=\"var(--lara-magenta)\" />\n            <h3 style={{ margin: 0, fontSize: '16px', fontWeight: 800 }}>Policy Decision Simulator</h3>\n          </div>\n\n          <form onSubmit={handleSimulatePolicy}>\n            <div style={{ marginBottom: '14px' }}>\n              <label className=\"lara-label\">Current Session Principal</label>\n              <input\n                type=\"text\"\n                className=\"lara-input\"\n                value={`${principal.display_name} (${principal.roles[0]} • ${principal.attributes.clearance})`}\n                readOnly\n                style={{ background: '#F8FAF2', color: 'var(--lara-muted)' }}\n              />\n            </div>\n\n            <div style={{ marginBottom: '14px' }}>\n              <label className=\"lara-label\">Target Capability / Tool / Action</label>\n              <select\n                className=\"lara-select\"\n                value={action}\n                onChange={(e) => {\n                  setAction(e.target.value);\n                  setResourceId(e.target.value);\n                }}\n              >\n                <option value=\"tool:maintenance-request\">tool:maintenance-request (Simulated Maintenance Dispatch)</option>\n                <option value=\"source:vendor-contract\">source:vendor-contract (Confidential Tier-1 SLA Read)</option>\n                <option value=\"tool:calculator-safe\">tool:calculator-safe (Vibration Severity Calc)</option>\n                <option value=\"tool:equipment-control\">tool:equipment-control (Physical Actuation)</option>\n              </select>\n            </div>\n\n            <div style={{ marginBottom: '16px' }}>\n              <label className=\"lara-label\">Evaluation Purpose</label>\n              <input\n                type=\"text\"\n                className=\"lara-input\"\n                value={purpose}\n                onChange={(e) => setPurpose(e.target.value)}\n              />\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={isEvaluating}\n              className=\"lara-button lara-button--primary\"\n              style={{ width: '100%' }}\n            >\n              <Play size={14} />\n              {isEvaluating ? 'Evaluating via Backend Policy Engine...' : 'Evaluate Access Policy'}\n            </button>\n          </form>\n\n          {/* Decision Output Card */}\n          {decision && (\n            <div\n              style={{\n                marginTop: '20px',\n                padding: '16px',\n                borderRadius: 'var(--lara-radius-sm)',\n                background: decision.decision === 'ALLOW' ? '#E4F9EE' : decision.decision === 'REQUIRE_APPROVAL' ? '#FFF1EA' : '#FFF0EB',\n                border: decision.decision === 'ALLOW' ? '1.5px solid #B2F0CF' : decision.decision === 'REQUIRE_APPROVAL' ? '1.5px solid #FFC6AF' : '1.5px solid #FFD2C0',\n              }}\n            >\n              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>\n                <span style={{ fontSize: '12px', fontWeight: 800, color: 'var(--lara-muted)', textTransform: 'uppercase' }}>\n                  Policy Engine Result\n                </span>\n                {getDecisionBadge(decision.decision)}\n              </div>\n\n              <div style={{ fontSize: '13px', fontWeight: 800, marginBottom: '4px' }}>\n                Reason Code: <code>{decision.reason_code}</code>\n              </div>\n              <div style={{ fontSize: '12px', color: 'var(--lara-muted)', marginBottom: '8px' }}>\n                Governing Policy ID: <code>{decision.policy_id}</code>\n              </div>\n              <div style={{ fontSize: '11px', color: 'var(--lara-muted)' }}>\n                Evaluated at {new Date(decision.evaluated_at).toLocaleTimeString()} for principal {principal.principal_id}\n              </div>\n            </div>\n          )}\n\n          <div\n            style={{\n              marginTop: '16px',\n              padding: '10px 14px',\n              borderRadius: 'var(--lara-radius-sm)',\n              background: 'var(--lara-surface-subtle)',\n              fontSize: '11px',\n              color: 'var(--lara-muted)',\n              display: 'flex',\n              alignItems: 'center',\n              gap: '6px',\n            }}\n          >\n            <Lock size={13} />\n            Policy mutation is strictly immutable in the prototype; policy rules cannot be altered client-side.\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"],"file":"/src/features/governance/GovernanceView.tsx"}