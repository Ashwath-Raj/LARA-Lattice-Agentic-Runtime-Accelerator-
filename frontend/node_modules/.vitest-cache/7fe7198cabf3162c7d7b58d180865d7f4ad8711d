vent } from '../../api/types';\nimport { useAuth } from '../auth/AuthContext';\nimport {\n  Clock,\n  Cpu,\n  FileCheck2,\n  FileWarning,\n  ShieldAlert,\n  ArrowRight,\n  ExternalLink,\n  ChevronLeft,\n  Flame,\n} from 'lucide-react';\n\ninterface TaskDetailViewProps {\n  task: Task;\n  events?: TaskEvent[];\n  onBack: () => void;\n  onNavigateToHighways: () => void;\n  onNavigateToApprovals: () => void;\n}\n\nexport const TaskDetailView: React.FC<TaskDetailViewProps> = ({\n  task,\n  events = [],\n  onBack,\n  onNavigateToHighways,\n  onNavigateToApprovals,\n}) => {\n  const { principal } = useAuth();\n  const [activeTab, setActiveTab] = useState<'evidence' | 'agents' | 'verification' | 'events'>('evidence');\n\n  const stages = [\n    { id: 'INTAKE', label: '1. Intake & Normalisation' },\n    { id: 'HIGHWAY_RESOLUTION', label: '2. Dynamic Route' },\n    { id: 'RESEARCH', label: '3. Research Agent' },\n    { id: 'ANALYSIS', label: '4. Analysis Agent' },\n    { id: 'VERIFICATION', label: '5. Verification Agent' },\n    { id: 'POLICY_EVALUATION', label: '6. Policy Check' },\n    { id: 'ACTION_GATEWAY', label: '7. Simulated Action' },\n  ];\n\n  const getStageIndex = (stage: string) => {\n    switch (stage) {\n      case 'INTAKE': return 0;\n      case 'HIGHWAY_RESOLUTION': return 1;\n      case 'RESEARCH': return 2;\n      case 'ANALYSIS': return 3;\n      case 'VERIFICATION': return 4;\n      case 'POLICY_EVALUATION': return 5;\n      case 'ACTION_GATEWAY': return 6;\n      case 'COMPLETED': return 7;\n      default: return 0;\n    }\n  };\n\n  const currentStageIdx = getStageIndex(task.current_stage);\n\n  const getStatusBadge = (status: string) => {\n    switch (status) {\n      case 'COMPLETED':\n        return <span className=\"lara-badge lara-badge--allow\">COMPLETED</span>;\n      case 'AWAITING_APPROVAL':\n        return <span className=\"lara-badge lara-badge--review\">AWAITING APPROVAL</span>;\n      case 'RUNNING':\n        return <span className=\"lara-badge lara-badge--routing\">RUNNING</span>;\n      case 'FAILED':\n        return <span className=\"lara-badge lara-badge--deny\">FAILED</span>;\n      default:\n        return <span className=\"lara-badge lara-badge--neutral\">{status}</span>;\n    }\n  };\n\n  return (\n    <div>\n      {/* Top action bar */}\n      <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '20px' }}>\n        <button\n          onClick={onBack}\n          className=\"lara-button lara-button--secondary lara-button--sm\"\n          style={{ display: 'flex', alignItems: 'center', gap: '6px' }}\n        >\n          <ChevronLeft size={16} />\n          Back to Workbench\n        </button>\n\n        <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n          <button\n            onClick={onNavigateToHighways}\n            className=\"lara-button lara-button--secondary lara-button--sm\"\n            style={{ color: 'var(--lara-blue)' }}\n          >\n            <ExternalLink size={14} />\n            View Dynamic Route in Graph\n          </button>\n        </div>\n      </div>\n\n      {/* Task Header Panel */}\n      <div className=\"lara-panel\" style={{ marginBottom: '24px' }}>\n        <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px', marginBottom: '16px' }}>\n          <div>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginBottom: '8px' }}>\n              <span className=\"lara-badge lara-badge--synthetic\">SYNTHETIC TASK</span>\n              {task.incident_id && (\n                <span className=\"lara-badge lara-badge--neutral\" style={{ fontWeight: 800 }}>\n                  {task.incident_id}\n                </span>\n              )}\n              {getStatusBadge(task.status)}\n            </div>\n            <h1 style={{ margin: '0 0 8px', fontSize: '24px', fontWeight: 900 }}>{task.title}</h1>\n            <p style={{ margin: 0, fontSize: '14px', color: 'var(--lara-ink)', maxWidth: '900px', lineHeight: 1.5 }}>\n              {task.prompt}\n            </p>\n          </div>\n\n          <div\n            style={{\n              background: 'var(--lara-surface-subtle)',\n              border: '1px solid var(--lara-line)',\n              borderRadius: 'var(--lara-radius-sm)',\n              padding: '12px 16px',\n              fontSize: '12px',\n              minWidth: '220px',\n            }}\n          >\n            <div style={{ color: 'var(--lara-muted)', marginBottom: '4px' }}>Metadata</div>\n            <div><strong>Task ID:</strong> <code>{task.task_id}</code></div>\n            <div><strong>Trace ID:</strong> <code>{task.trace_id}</code></div>\n            <div><strong>Session Principal:</strong> {principal.display_name}</div>\n            <div><strong>Created:</strong> {new Date(task.created_at).toLocaleTimeString()}</div>\n          </div>\n        </div>\n\n        {/* Stage Timeline */}\n        <div style={{ marginTop: '24px', paddingTop: '20px', borderTop: '1px solid var(--lara-line)' }}>\n          <div style={{ fontSize: '12px', fontWeight: 700, color: 'var(--lara-muted)', textTransform: 'uppercase', marginBottom: '12px' }}>\n            Orchestration State Machine Progression\n          </div>\n          <div style={{ display: 'flex', alignItems: 'center', gap: '8px', overflowX: 'auto', paddingBottom: '6px' }}>\n            {stages.map((stage, idx) => {\n              const isPast = idx < currentStageIdx;\n              const isCurrent = idx === currentStageIdx;\n              return (\n                <React.Fragment key={stage.id}>\n                  <div\n                    style={{\n                      padding: '8px 12px',\n                      borderRadius: 'var(--lara-radius-sm)',\n                      background: isCurrent ? 'var(--lara-lime)' : isPast ? '#E4F9EE' : 'var(--lara-surface-subtle)',\n                      border: isCurrent ? '1.5px solid #283800' : isPast ? '1px solid #B2F0CF' : '1px solid var(--lara-line)',\n                      color: isCurrent ? '#283800' : isPast ? '#0E7741' : 'var(--lara-muted)',\n                      fontSize: '11px',\n                      fontWeight: isCurrent ? 800 : 700,\n                      whiteSpace: 'nowrap',\n                    }}\n                  >\n                    {stage.label}\n                  </div>\n                  {idx < stages.length - 1 && (\n                    <ArrowRight size={14} color=\"var(--lara-line)\" style={{ flexShrink: 0 }} />\n                  )}\n                </React.Fragment>\n              );\n            })}\n          </div>\n        </div>\n      </div>\n\n      {/* Proposed Action Banner (if review or execution needed) */}\n      {task.proposed_action && (\n        <div\n          className=\"lara-panel\"\n          style={{\n            marginBottom: '24px',\n            background: task.proposed_action.policy_decision === 'REQUIRE_APPROVAL' ? 'var(--lara-panel--orange)' : 'var(--lara-white)',\n            border: '2px solid var(--lara-orange)',\n          }}\n        >\n          <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n            <div style={{ display: 'flex', alignItems: 'flex-start', gap: '14px' }}>\n              <div\n                style={{\n                  background: 'var(--lara-orange)',\n                  color: 'white',\n                  padding: '10px',\n                  borderRadius: '12px',\n                  display: 'flex',\n                }}\n              >\n                <Flame size={22} />\n              </div>\n              <div>\n                <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '4px' }}>\n                  <span className=\"lara-badge lara-badge--review\">POLICY DECISION: {task.proposed_action.policy_decision}</span>\n                  <span className=\"lara-badge lara-badge--synthetic\">SIMULATED ACTION</span>\n                </div>\n                <h3 style={{ margin: '0 0 6px', fontSize: '18px', fontWeight: 800 }}>\n                  {task.proposed_action.description}\n                </h3>\n                <div style={{ fontSize: '13px', color: 'var(--lara-ink)', marginBottom: '8px' }}>\n                  Target Tool: <code>{task.proposed_action.tool_name}</code> &bull; Reason Code: <code>{task.proposed_action.reason_code}</code>\n                </div>\n                <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n                  This action dispatches a simulated enterprise maintenance work order. In compliance with separation of duties, it requires Supervisor approval.\n                </div>\n              </div>\n            </div>\n\n            <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n              <button\n                onClick={onNavigateToApprovals}\n                className=\"lara-button lara-button--action\"\n              >\n                <ShieldAlert size={16} />\n                Open in Supervisor Queue\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      {/* Detail Sections Tabs */}\n      <div style={{ display: 'flex', gap: '8px', borderBottom: '1.5px solid var(--lara-line)', marginBottom: '20px' }}>\n        <button\n          onClick={() => setActiveTab('evidence')}\n          style={{\n            padding: '10px 18px',\n            background: 'transparent',\n            border: 'none',\n            borderBottom: activeTab === 'evidence' ? '3px solid var(--lara-blue)' : '3px solid transparent',\n            color: activeTab === 'evidence' ? 'var(--lara-blue)' : 'var(--lara-muted)',\n            fontWeight: 800,\n            fontSize: '14px',\n            cursor: 'pointer',\n          }}\n        >\n          Authorised Evidence ({task.evidence.length})\n        </button>\n        <button\n          onClick={() => setActiveTab('agents')}\n          style={{\n            padding: '10px 18px',\n            background: 'transparent',\n            border: 'none',\n            borderBottom: activeTab === 'agents' ? '3px solid var(--lara-blue)' : '3px solid transparent',\n            color: activeTab === 'agents' ? 'var(--lara-blue)' : 'var(--lara-muted)',\n            fontWeight: 800,\n            fontSize: '14px',\n            cursor: 'pointer',\n          }}\n        >\n          Specialist Agent Outputs ({task.agent_outputs.length})\n        </button>\n        <button\n          onClick={() => setActiveTab('verification')}\n          style={{\n            padding: '10px 18px',\n            background: 'transparent',\n            border: 'none',\n            borderBottom: activeTab === 'verification' ? '3px solid var(--lara-blue)' : '3px solid transparent',\n            color: activeTab === 'verification' ? 'var(--lara-blue)' : 'var(--lara-muted)',\n            fontWeight: 800,\n            fontSize: '14px',\n            cursor: 'pointer',\n          }}\n        >\n          Verification Audit ({task.verification_findings.length})\n        </button>\n        <button\n          onClick={() => setActiveTab('events')}\n          style={{\n            padding: '10px 18px',\n            background: 'transparent',\n            border: 'none',\n            borderBottom: activeTab === 'events' ? '3px solid var(--lara-blue)' : '3px solid transparent',\n            color: activeTab === 'events' ? 'var(--lara-blue)' : 'var(--lara-muted)',\n            fontWeight: 800,\n            fontSize: '14px',\n            cursor: 'pointer',\n          }}\n        >\n          Execution Events ({events.length})\n        </button>\n      </div>\n\n      {/* Tab 1: Evidence */}\n      {activeTab === 'evidence' && (\n        <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fill, minmax(420px, 1fr))', gap: '16px' }}>\n          {task.evidence.map((ev) => (\n            <div key={ev.source_id} className=\"lara-panel lara-panel--sm\">\n              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>\n                <span className=\"lara-badge lara-badge--routing\" style={{ fontSize: '11px' }}>\n                  {ev.source_id}\n                </span>\n                <div style={{ display: 'flex', gap: '6px' }}>\n                  <span className=\"lara-badge lara-badge--neutral\">{ev.classification}</span>\n                  {ev.status === 'CURRENT' ? (\n                    <span className=\"lara-badge lara-badge--allow\">REV {ev.revision} CURRENT</span>\n                  ) : (\n                    <span className=\"lara-badge lara-badge--deny\">OBSOLETE</span>\n                  )}\n                </div>\n              </div>\n\n              <h4 style={{ margin: '0 0 6px', fontSize: '15px', fontWeight: 800 }}>{ev.name}</h4>\n              <p style={{ margin: '0 0 12px', fontSize: '13px', color: 'var(--lara-ink)', lineHeight: 1.4 }}>\n                {ev.summary}\n              </p>\n\n              <div\n                style={{\n                  display: 'flex',\n                  alignItems: 'center',\n                  justifyContent: 'space-between',\n                  paddingTop: '8px',\n                  borderTop: '1px solid var(--lara-line)',\n                  fontSize: '11px',\n                  color: 'var(--lara-muted)',\n                }}\n              >\n                <span>Effective Date: {ev.effective_date}</span>\n                {ev.verified ? (\n                  <span style={{ color: 'var(--lara-green)', fontWeight: 700, display: 'flex', alignItems: 'center', gap: '4px' }}>\n                    <FileCheck2 size={13} /> Authenticated\n                  </span>\n                ) : (\n                  <span style={{ color: 'var(--lara-orange)', fontWeight: 700, display: 'flex', alignItems: 'center', gap: '4px' }}>\n                    <FileWarning size={13} /> Unverified\n                  </span>\n                )}\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Tab 2: Specialist Agent Outputs */}\n      {activeTab === 'agents' && (\n        <div style={{ display: 'flex', flexDirection: 'column', gap: '16px' }}>\n          {task.agent_outputs.map((agent) => (\n            <div key={agent.agent_id} className=\"lara-panel\">\n              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '10px' }}>\n                <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n                  <div style={{ background: 'var(--lara-lilac)', padding: '8px', borderRadius: '10px' }}>\n                    <Cpu size={20} color=\"var(--lara-ink)\" />\n                  </div>\n                  <div>\n                    <h4 style={{ margin: 0, fontSize: '16px', fontWeight: 800 }}>{agent.agent_name}</h4>\n                    <span style={{ fontSize: '11px', color: 'var(--lara-muted)' }}>\n                      Version: {agent.version} &bull; Model: Gemini 2.0 via Vertex AI Adapter\n                    </span>\n                  </div>\n                </div>\n\n                <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n                  <span className=\"lara-badge lara-badge--allow\">\n                    CONFIDENCE: {Math.round(agent.confidence_score * 100)}%\n                  </span>\n                  <span style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>{agent.duration_ms}ms</span>\n                </div>\n              </div>\n\n              <p style={{ margin: '0 0 12px', fontSize: '14px', lineHeight: 1.5, background: 'var(--lara-surface-subtle)', padding: '12px', borderRadius: 'var(--lara-radius-sm)' }}>\n                {agent.summary}\n              </p>\n\n              <div>\n                <div style={{ fontSize: '12px', fontWeight: 700, color: 'var(--lara-muted)', textTransform: 'uppercase', marginBottom: '6px' }}>\n                  Key Findings\n                </div>\n                <ul style={{ margin: 0, paddingLeft: '20px', fontSize: '13px', lineHeight: 1.6 }}>\n                  {agent.findings.map((f, i) => (\n                    <li key={i}>{f}</li>\n                  ))}\n                </ul>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Tab 3: Verification Findings */}\n      {activeTab === 'verification' && (\n        <div className=\"lara-panel\">\n          <h3 style={{ margin: '0 0 16px', fontSize: '16px', fontWeight: 800 }}>\n            Verification Agent Claim Cross-Audit\n          </h3>\n          <table style={{ width: '100%', borderCollapse: 'collapse', fontSize: '13px' }}>\n            <thead>\n              <tr style={{ borderBottom: '2px solid var(--lara-line)', textAlign: 'left', color: 'var(--lara-muted)' }}>\n                <th style={{ padding: '8px 12px' }}>Investigative Claim</th>\n                <th style={{ padding: '8px 12px' }}>Audit Status</th>\n                <th style={{ padding: '8px 12px' }}>Source Reference</th>\n                <th style={{ padding: '8px 12px' }}>Audit Notes</th>\n              </tr>\n            </thead>\n            <tbody>\n              {task.verification_findings.map((vf, i) => (\n                <tr key={i} style={{ borderBottom: '1px solid var(--lara-line)' }}>\n                  <td style={{ padding: '10px 12px', fontWeight: 600 }}>{vf.claim}</td>\n                  <td style={{ padding: '10px 12px' }}>\n                    <span className=\"lara-badge lara-badge--allow\" style={{ fontSize: '11px' }}>\n                      {vf.status}\n                    </span>\n                  </td>\n                  <td style={{ padding: '10px 12px' }}>\n                    <code>{vf.source_reference}</code>\n                  </td>\n                  <td style={{ padding: '10px 12px', color: 'var(--lara-muted)' }}>{vf.notes}</td>\n                </tr>\n              ))}\n            </tbody>\n          </table>\n        </div>\n      )}\n\n      {/* Tab 4: Events Timeline */}\n      {activeTab === 'events' && (\n        <div className=\"lara-panel\">\n          <h3 style={{ margin: '0 0 16px', fontSize: '16px', fontWeight: 800 }}>\n            Task Execution Event Stream\n          </h3>\n          <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>\n            {events.map((ev) => (\n              <div\n                key={ev.event_id}\n                style={{\n                  display: 'flex',\n                  alignItems: 'flex-start',\n                  gap: '12px',\n                  padding: '10px 14px',\n                  borderRadius: 'var(--lara-radius-sm)',\n                  background: 'var(--lara-surface-subtle)',\n                  border: '1px solid var(--lara-line)',\n                }}\n              >\n                <Clock size={16} color=\"var(--lara-muted)\" style={{ marginTop: '2px' }} />\n                <div style={{ flex: 1 }}>\n                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between' }}>\n                    <strong style={{ fontSize: '13px' }}>{ev.summary}</strong>\n                    <span style={{ fontSize: '11px', color: 'var(--lara-muted)' }}>\n                      {new Date(ev.timestamp).toLocaleTimeString()}\n                    </span>\n                  </div>\n                  <div style={{ fontSize: '11px', color: 'var(--lara-muted)', marginTop: '2px' }}>\n                    Stage: <code>{ev.stage}</code> {ev.agent_id ? `• Agent: ${ev.agent_id}` : ''}\n                  </div>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"],"file":"/src/features/workbench/TaskDetailView.tsx"}