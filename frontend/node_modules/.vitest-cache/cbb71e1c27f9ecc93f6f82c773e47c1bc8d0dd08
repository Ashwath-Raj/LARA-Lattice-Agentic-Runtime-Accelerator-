cAAc;WACd,YAAY,aAAa,+BAA+B;WACxD,QAAQ,aAAa,+BAA+B;WACpD,SAAS;WACT,YAAY;WACZ,gBAAgB;WAChB,WAAW;WACX,QAAQ;WACR,OAAO;UACT;oBAlBF,CAoBE,iDAAC,OAAD;WAAK,OAAO;YAAE,SAAS;YAAQ,YAAY;YAAU,KAAK;WAAO;qBAAjE,CACE,iDAAC,OAAD,EACE,OAAO;YACL,OAAO;YACP,QAAQ;YACR,cAAc;YACd,YAAY,kBAAkB,EAAE,MAAM,EAAE;WAC1C,EACD;;;;qBACD,iDAAC,OAAD,aACE,iDAAC,OAAD;YAAK,OAAO;aAAE,UAAU;aAAQ,YAAY,aAAa,MAAM;YAAI;sBAChE,EAAE;WACA;;;;qBACL,iDAAC,OAAD;YAAK,OAAO;aAAE,UAAU;aAAQ,OAAO;YAAoB;sBAA3D;aAA8D;aACtD,iDAAC,UAAD,YAAS,EAAE,MAAM,GAAW;;;;;aAAC;aAAe,EAAE,WAAW;YAC5D;;;;;mBACF;;;;mBACF;;;;;oBACJ,cAAc,oDAAC,qCAAD;WAAc,MAAM;WAAI,OAAM;UAAqB;;;;kBAC5D;YAtCD,EAAE;;;;gBAsCD;QAEZ,CAAC;OACE;;;;;OACL,iDAAC,OAAD;QACE,OAAO;SACL,WAAW;SACX,SAAS;SACT,YAAY;SACZ,cAAc;SACd,UAAU;SACV,OAAO;SACP,YAAY;QACd;kBATF,CAWE,oDAAC,kCAAD;SAAW,MAAM;SAAI,OAAO;UAAE,SAAS;UAAU,aAAa;SAAM;QAAI;;;;kBAAC,8EAEtE;;;;;;MACF;;;;;aAEJ;;;;;;GACF;;;;;UACC;;;;;;AAEZ","names":[],"ignoreList":[],"sources":["Navbar.tsx"],"sourcesContent":["import React, { useState } from 'react';\nimport { useAuth } from '../../features/auth/AuthContext';\nimport {\n  Layers,\n  GitBranch,\n  Cpu,\n  Sparkles,\n  ShieldCheck,\n  ClipboardList,\n  History,\n  ChevronDown,\n  UserCheck,\n  CheckCircle2,\n} from 'lucide-react';\n\nexport type NavTab = 'workbench' | 'highways' | 'agents' | 'evolution' | 'governance' | 'approvals' | 'audit';\n\ninterface NavbarProps {\n  activeTab: NavTab;\n  onTabChange: (tab: NavTab) => void;\n  pendingApprovalsCount?: number;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({ activeTab, onTabChange, pendingApprovalsCount = 1 }) => {\n  const { principal, allPrincipals, switchIdentity, isLoading } = useAuth();\n  const [isIdentityMenuOpen, setIsIdentityMenuOpen] = useState(false);\n\n  const navItems = [\n    { id: 'workbench' as NavTab, label: 'Workbench', icon: Layers },\n    { id: 'highways' as NavTab, label: 'Information Highways', icon: GitBranch },\n    { id: 'agents' as NavTab, label: 'Agents', icon: Cpu },\n    { id: 'evolution' as NavTab, label: 'Evolution Lab', icon: Sparkles, badge: '1 Candidate' },\n    { id: 'governance' as NavTab, label: 'Governance', icon: ShieldCheck },\n    { id: 'approvals' as NavTab, label: 'Approvals', icon: ClipboardList, badgeCount: pendingApprovalsCount },\n    { id: 'audit' as NavTab, label: 'Audit Trail', icon: History },\n  ];\n\n  const getRoleBadgeStyle = (role: string) => {\n    switch (role) {\n      case 'runtime_admin':\n        return 'var(--lara-violet)';\n      case 'supervisor':\n        return 'var(--lara-orange)';\n      case 'auditor':\n        return 'var(--lara-ink)';\n      default:\n        return 'var(--lara-blue)';\n    }\n  };\n\n  return (\n    <header style={{ borderBottom: '1px solid var(--lara-line)', background: 'var(--lara-white)' }}>\n      {/* Synthetic environment alert banner */}\n      <div\n        style={{\n          background: 'var(--lara-lime)',\n          padding: '6px 20px',\n          fontSize: '11px',\n          fontWeight: 800,\n          letterSpacing: '0.06em',\n          display: 'flex',\n          alignItems: 'center',\n          justifyContent: 'space-between',\n          color: '#283800',\n        }}\n      >\n        <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n          <span\n            style={{\n              background: '#283800',\n              color: 'var(--lara-white)',\n              padding: '2px 6px',\n              borderRadius: '4px',\n              fontSize: '10px',\n            }}\n          >\n            SYNTHETIC DEMO ENVIRONMENT\n          </span>\n          <span>Google Cloud Vertex AI &amp; Firestore Native Monolith Architecture</span>\n        </div>\n        <div style={{ fontSize: '11px', opacity: 0.85 }}>\n          Seeded Demo Dataset &bull; No Production Writes Permitted\n        </div>\n      </div>\n\n      {/* Main navigation row */}\n      <div className=\"lara-container\" style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', height: '72px' }}>\n        {/* LARA Brand & Mark */}\n        <div style={{ display: 'flex', alignItems: 'center', gap: '14px', cursor: 'pointer' }} onClick={() => onTabChange('workbench')}>\n          <svg width=\"42\" height=\"42\" viewBox=\"0 0 180 180\" role=\"img\" aria-label=\"LARA mark\">\n            <rect x=\"8\" y=\"8\" width=\"164\" height=\"164\" rx=\"38\" fill=\"#101014\" />\n            <path d=\"M46 43V111H91\" fill=\"none\" stroke=\"#4B43F5\" strokeWidth=\"23\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            <path d=\"M91 111H134V72\" fill=\"none\" stroke=\"#00B9E8\" strokeWidth=\"21\" strokeLinecap=\"round\" strokeLinejoin=\"round\" />\n            <path d=\"M91 111V139\" fill=\"none\" stroke=\"#EC00D4\" strokeWidth=\"18\" strokeLinecap=\"round\" />\n            <circle cx=\"46\" cy=\"43\" r=\"12\" fill=\"#23C978\" />\n            <circle cx=\"134\" cy=\"72\" r=\"12\" fill=\"#FF7138\" />\n            <circle cx=\"91\" cy=\"139\" r=\"10\" fill=\"#C7B9FF\" />\n          </svg>\n          <div>\n            <div style={{ fontSize: '20px', fontWeight: 900, letterSpacing: '-0.02em', lineHeight: 1.1 }}>\n              LARA\n            </div>\n            <div style={{ fontSize: '10px', fontWeight: 700, letterSpacing: '0.08em', color: 'var(--lara-muted)' }}>\n              LATTICE AGENTIC RUNTIME\n            </div>\n          </div>\n        </div>\n\n        {/* Tab Links */}\n        <nav style={{ display: 'flex', alignItems: 'center', gap: '6px' }}>\n          {navItems.map((item) => {\n            const Icon = item.icon;\n            const isActive = activeTab === item.id;\n            return (\n              <button\n                key={item.id}\n                onClick={() => onTabChange(item.id)}\n                className=\"lara-button lara-button--ghost\"\n                style={{\n                  padding: '8px 14px',\n                  borderRadius: 'var(--lara-radius-sm)',\n                  background: isActive ? 'var(--lara-canvas)' : 'transparent',\n                  color: isActive ? 'var(--lara-blue)' : 'var(--lara-ink)',\n                  border: isActive ? '1.5px solid var(--lara-line)' : '1.5px solid transparent',\n                  fontWeight: isActive ? 800 : 600,\n                  fontSize: '13px',\n                  position: 'relative',\n                }}\n              >\n                <Icon size={16} color={isActive ? 'var(--lara-blue)' : 'var(--lara-muted)'} />\n                <span>{item.label}</span>\n                {item.badge && (\n                  <span\n                    style={{\n                      background: 'var(--lara-violet)',\n                      color: 'white',\n                      fontSize: '10px',\n                      padding: '2px 6px',\n                      borderRadius: '999px',\n                      fontWeight: 800,\n                    }}\n                  >\n                    {item.badge}\n                  </span>\n                )}\n                {item.badgeCount !== undefined && item.badgeCount > 0 && (\n                  <span\n                    style={{\n                      background: 'var(--lara-orange)',\n                      color: 'white',\n                      fontSize: '10px',\n                      padding: '2px 6px',\n                      borderRadius: '999px',\n                      fontWeight: 800,\n                    }}\n                  >\n                    {item.badgeCount}\n                  </span>\n                )}\n              </button>\n            );\n          })}\n        </nav>\n\n        {/* Demo Identity Switcher Dropdown */}\n        <div style={{ position: 'relative' }}>\n          <button\n            onClick={() => setIsIdentityMenuOpen(!isIdentityMenuOpen)}\n            className=\"lara-button lara-button--secondary\"\n            style={{\n              padding: '6px 14px',\n              borderRadius: 'var(--lara-radius-pill)',\n              border: '1.5px solid var(--lara-line)',\n              display: 'flex',\n              alignItems: 'center',\n              gap: '10px',\n              fontSize: '13px',\n              background: 'white',\n            }}\n            aria-expanded={isIdentityMenuOpen}\n            aria-label=\"Switch demo principal\"\n          >\n            <div\n              style={{\n                width: '10px',\n                height: '10px',\n                borderRadius: '50%',\n                background: getRoleBadgeStyle(principal.roles[0]),\n              }}\n            />\n            <div style={{ textAlign: 'left', lineHeight: 1.2 }}>\n              <div style={{ fontWeight: 800 }}>{principal.display_name}</div>\n              <div style={{ fontSize: '10px', color: 'var(--lara-muted)', textTransform: 'capitalize' }}>\n                {principal.roles[0]} &bull; {principal.attributes.clearance}\n              </div>\n            </div>\n            <ChevronDown size={14} color=\"var(--lara-muted)\" />\n          </button>\n\n          {isIdentityMenuOpen && (\n            <div\n              className=\"lara-panel\"\n              style={{\n                position: 'absolute',\n                right: 0,\n                top: 'calc(100% + 8px)',\n                width: '320px',\n                padding: '12px',\n                zIndex: 100,\n                boxShadow: 'var(--lara-shadow-lg)',\n              }}\n            >\n              <div\n                style={{\n                  fontSize: '11px',\n                  fontWeight: 800,\n                  color: 'var(--lara-muted)',\n                  textTransform: 'uppercase',\n                  padding: '6px 8px',\n                  borderBottom: '1px solid var(--lara-line)',\n                  marginBottom: '8px',\n                }}\n              >\n                Switch Seeded Demo Principal\n              </div>\n              <div style={{ display: 'flex', flexDirection: 'column', gap: '4px' }}>\n                {allPrincipals.map((p) => {\n                  const isSelected = p.principal_id === principal.principal_id;\n                  return (\n                    <button\n                      key={p.principal_id}\n                      disabled={isLoading}\n                      onClick={async () => {\n                        await switchIdentity(p.principal_id);\n                        setIsIdentityMenuOpen(false);\n                      }}\n                      style={{\n                        padding: '10px 12px',\n                        borderRadius: 'var(--lara-radius-sm)',\n                        background: isSelected ? 'var(--lara-surface-subtle)' : 'transparent',\n                        border: isSelected ? '1px solid var(--lara-line)' : '1px solid transparent',\n                        display: 'flex',\n                        alignItems: 'center',\n                        justifyContent: 'space-between',\n                        textAlign: 'left',\n                        cursor: 'pointer',\n                        width: '100%',\n                      }}\n                    >\n                      <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n                        <div\n                          style={{\n                            width: '10px',\n                            height: '10px',\n                            borderRadius: '50%',\n                            background: getRoleBadgeStyle(p.roles[0]),\n                          }}\n                        />\n                        <div>\n                          <div style={{ fontSize: '13px', fontWeight: isSelected ? 800 : 600 }}>\n                            {p.display_name}\n                          </div>\n                          <div style={{ fontSize: '11px', color: 'var(--lara-muted)' }}>\n                            Role: <strong>{p.roles[0]}</strong> &bull; Dept: {p.attributes.department}\n                          </div>\n                        </div>\n                      </div>\n                      {isSelected && <CheckCircle2 size={16} color=\"var(--lara-green)\" />}\n                    </button>\n                  );\n                })}\n              </div>\n              <div\n                style={{\n                  marginTop: '10px',\n                  padding: '8px',\n                  background: 'var(--lara-canvas)',\n                  borderRadius: 'var(--lara-radius-sm)',\n                  fontSize: '11px',\n                  color: 'var(--lara-muted)',\n                  lineHeight: 1.4,\n                }}\n              >\n                <UserCheck size={12} style={{ display: 'inline', marginRight: '4px' }} />\n                Server re-evaluates Dynamic Information Highway routes upon identity change.\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </header>\n  );\n};\n"],"file":"/src/components/layout/Navbar.tsx"}