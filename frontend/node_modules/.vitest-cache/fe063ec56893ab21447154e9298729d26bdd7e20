E;SAAgF;SAClE,iBAAiB;SAAW;SAAK,iBAAiB;QAC3D;;;;;;MACF;;;;;;IAEJ;;;;;cAEL,iDAAC,OAAD;IAAK,WAAU;IAAa,OAAO;KAAE,WAAW;KAAU,SAAS;KAAQ,OAAO;IAAoB;cAAtG,CACE,oDAAC,sCAAD;KAAe,MAAM;KAAI,OAAO;MAAE,QAAQ;MAAc,SAAS;KAAQ;IAAI;;;;cAAC,6BAE3E;;;;;WAEJ;;;;;;CACF;;;;;AAET","names":[],"ignoreList":[],"sources":["ApprovalQueueView.tsx"],"sourcesContent":["import React, { useState, useEffect } from 'react';\nimport { ApprovalItem } from '../../api/types';\nimport { api } from '../../api/client';\nimport { useAuth } from '../auth/AuthContext';\nimport {\n  ClipboardList,\n  CheckCircle2,\n  XCircle,\n  AlertTriangle,\n  Flame,\n  ShieldCheck,\n  UserX,\n} from 'lucide-react';\n\nexport const ApprovalQueueView: React.FC = () => {\n  const { principal, versionChangeNonce } = useAuth();\n  const [approvals, setApprovals] = useState<ApprovalItem[]>([]);\n  const [selectedApproval, setSelectedApproval] = useState<ApprovalItem | null>(null);\n  const [decisionReason, setDecisionReason] = useState('Reviewed telemetry and verified against SOP-MNT-014 Rev 3.2.');\n  const [isDeciding, setIsDeciding] = useState(false);\n  const [errorMsg, setErrorMsg] = useState<string | null>(null);\n  const [successMsg, setSuccessMsg] = useState<string | null>(null);\n\n  const isSupervisorOrAdmin =\n    principal.roles.includes('supervisor') || principal.roles.includes('runtime_admin');\n\n  useEffect(() => {\n    api.getApprovals().then((list) => {\n      setApprovals(list);\n      if (list.length > 0) {\n        setSelectedApproval(list[0]);\n      }\n    });\n  }, [versionChangeNonce]);\n\n  const handleDecision = async (decision: 'APPROVE' | 'REJECT') => {\n    if (!selectedApproval) return;\n    setErrorMsg(null);\n    setSuccessMsg(null);\n\n    if (!isSupervisorOrAdmin) {\n      setErrorMsg('Access Denied: Only Supervisor or Administrator can approve actions.');\n      return;\n    }\n\n    if (selectedApproval.requester_id === principal.principal_id && !principal.roles.includes('runtime_admin')) {\n      setErrorMsg('Separation of Duties violation: You cannot approve your own requested action.');\n      return;\n    }\n\n    if (!decisionReason || decisionReason.trim().length < 8) {\n      setErrorMsg('A detailed decision reason (at least 8 characters) is required.');\n      return;\n    }\n\n    setIsDeciding(true);\n    try {\n      const updated = await api.decideApproval(selectedApproval.approval_id, {\n        decision,\n        reason: decisionReason,\n      });\n      setSelectedApproval(updated);\n      setApprovals((prev) => prev.map((a) => (a.approval_id === updated.approval_id ? updated : a)));\n      setSuccessMsg(`Action successfully ${decision === 'APPROVE' ? 'APPROVED' : 'REJECTED'}. Task status and audit trace updated.`);\n    } catch (err: unknown) {\n      setErrorMsg(err instanceof Error ? err.message : 'Failed to record decision');\n    } finally {\n      setIsDeciding(false);\n    }\n  };\n\n  return (\n    <div>\n      <div className=\"lara-panel\" style={{ marginBottom: '24px' }}>\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n          <div>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n              <span className=\"lara-badge lara-badge--review\">SUPERVISOR APPROVAL QUEUE</span>\n              <span className=\"lara-badge lara-badge--neutral\">SEPARATION OF DUTIES ENFORCED</span>\n            </div>\n            <h1 style={{ margin: 0, fontSize: '24px', fontWeight: 900 }}>Human-in-the-Loop Gateway</h1>\n            <p style={{ margin: '4px 0 0', fontSize: '14px', color: 'var(--lara-muted)' }}>\n              Operational actions and high-impact dispatch requests require human review before simulation or execution.\n            </p>\n          </div>\n\n          <div>\n            {isSupervisorOrAdmin ? (\n              <span className=\"lara-badge lara-badge--allow\" style={{ padding: '6px 14px' }}>\n                <ShieldCheck size={14} /> SUPERVISOR CLEARANCE VALIDATED\n              </span>\n            ) : (\n              <span className=\"lara-badge lara-badge--review\" style={{ padding: '6px 14px' }}>\n                <AlertTriangle size={14} /> OPERATOR SESSION (APPROVAL DISABLED)\n              </span>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {successMsg && (\n        <div\n          style={{\n            padding: '12px 16px',\n            borderRadius: 'var(--lara-radius-sm)',\n            marginBottom: '20px',\n            fontSize: '13px',\n            fontWeight: 700,\n            background: '#E4F9EE',\n            color: '#0E7741',\n            border: '1px solid #B2F0CF',\n          }}\n        >\n          {successMsg}\n        </div>\n      )}\n\n      {errorMsg && (\n        <div\n          style={{\n            padding: '12px 16px',\n            borderRadius: 'var(--lara-radius-sm)',\n            marginBottom: '20px',\n            fontSize: '13px',\n            fontWeight: 700,\n            background: '#FFF0EB',\n            color: '#B53A0A',\n            border: '1px solid #FFD2C0',\n          }}\n        >\n          {errorMsg}\n        </div>\n      )}\n\n      <div style={{ display: 'grid', gridTemplateColumns: '360px 1fr', gap: '24px' }}>\n        {/* Approvals List */}\n        <div className=\"lara-panel\" style={{ padding: '16px' }}>\n          <h3 style={{ margin: '0 0 12px', fontSize: '15px', fontWeight: 800 }}>\n            Pending Actions ({approvals.filter((a) => a.status === 'PENDING').length})\n          </h3>\n\n          <div style={{ display: 'flex', flexDirection: 'column', gap: '8px' }}>\n            {approvals.map((item) => {\n              const isSelected = selectedApproval?.approval_id === item.approval_id;\n              return (\n                <div\n                  key={item.approval_id}\n                  onClick={() => setSelectedApproval(item)}\n                  style={{\n                    padding: '12px',\n                    borderRadius: 'var(--lara-radius-sm)',\n                    background: isSelected ? 'var(--lara-surface-subtle)' : '#FFFFFF',\n                    border: isSelected ? '1.5px solid var(--lara-orange)' : '1px solid var(--lara-line)',\n                    cursor: 'pointer',\n                  }}\n                >\n                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '6px' }}>\n                    <span className=\"lara-badge lara-badge--synthetic\" style={{ fontSize: '9px' }}>\n                      {item.tool_name}\n                    </span>\n                    <span\n                      className={`lara-badge ${\n                        item.status === 'APPROVED'\n                          ? 'lara-badge--allow'\n                          : item.status === 'REJECTED'\n                          ? 'lara-badge--deny'\n                          : 'lara-badge--review'\n                      }`}\n                      style={{ fontSize: '10px' }}\n                    >\n                      {item.status}\n                    </span>\n                  </div>\n                  <div style={{ fontWeight: 800, fontSize: '13px', marginBottom: '4px' }}>\n                    {item.action}\n                  </div>\n                  <div style={{ fontSize: '11px', color: 'var(--lara-muted)' }}>\n                    Requester: <code>{item.requester_name}</code>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Selected Approval Details & Action */}\n        {selectedApproval ? (\n          <div className=\"lara-panel\">\n            <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', marginBottom: '16px' }}>\n              <div>\n                <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n                  <span className=\"lara-badge lara-badge--synthetic\">ACTION ID: {selectedApproval.approval_id}</span>\n                  <span className=\"lara-badge lara-badge--review\">RISK LEVEL: {selectedApproval.risk_level}</span>\n                </div>\n                <h2 style={{ margin: '0 0 6px', fontSize: '20px', fontWeight: 800 }}>\n                  {selectedApproval.action}\n                </h2>\n                <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n                  Associated Task: <code>{selectedApproval.task_id}</code> &bull; Trace: <code>{selectedApproval.trace_id}</code>\n                </div>\n              </div>\n\n              <div style={{ textAlign: 'right', fontSize: '12px', color: 'var(--lara-muted)' }}>\n                Requested by: <strong>{selectedApproval.requester_name}</strong>\n                <div>{new Date(selectedApproval.created_at).toLocaleTimeString()}</div>\n              </div>\n            </div>\n\n            <div\n              style={{\n                background: '#FFF0EB',\n                border: '1px solid #FFD2C0',\n                padding: '14px',\n                borderRadius: 'var(--lara-radius-sm)',\n                marginBottom: '16px',\n              }}\n            >\n              <div style={{ display: 'flex', alignItems: 'center', gap: '8px', color: '#B53A0A', fontWeight: 800, fontSize: '13px', marginBottom: '4px' }}>\n                <Flame size={16} />\n                Policy Check: {selectedApproval.policy_reason}\n              </div>\n              <div style={{ fontSize: '13px', color: 'var(--lara-ink)', lineHeight: 1.4 }}>\n                <strong>Evidence Summary:</strong> {selectedApproval.evidence_summary}\n              </div>\n            </div>\n\n            {selectedApproval.status === 'PENDING' ? (\n              <div style={{ marginTop: '20px', paddingTop: '16px', borderTop: '1px solid var(--lara-line)' }}>\n                {selectedApproval.requester_id === principal.principal_id && !principal.roles.includes('runtime_admin') ? (\n                  <div\n                    style={{\n                      background: '#FFF0EB',\n                      padding: '12px',\n                      borderRadius: 'var(--lara-radius-sm)',\n                      color: '#B53A0A',\n                      fontSize: '13px',\n                      fontWeight: 700,\n                      display: 'flex',\n                      alignItems: 'center',\n                      gap: '8px',\n                      marginBottom: '14px',\n                    }}\n                  >\n                    <UserX size={16} />\n                    Separation of Duties Violation: You ({principal.display_name}) requested this action. Switch identity to Ravi Supervisor to approve.\n                  </div>\n                ) : null}\n\n                <div style={{ marginBottom: '16px' }}>\n                  <label className=\"lara-label\">Mandatory Decision Justification Reason *</label>\n                  <input\n                    type=\"text\"\n                    className=\"lara-input\"\n                    value={decisionReason}\n                    onChange={(e) => setDecisionReason(e.target.value)}\n                    placeholder=\"Provide justification citing SOP and evidence...\"\n                    disabled={isDeciding || !isSupervisorOrAdmin}\n                  />\n                  <div style={{ fontSize: '11px', color: 'var(--lara-muted)', marginTop: '4px' }}>\n                    Min 8 characters required. Decision will be signed and written to immutable audit records.\n                  </div>\n                </div>\n\n                <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>\n                  <button\n                    onClick={() => handleDecision('REJECT')}\n                    disabled={isDeciding || !isSupervisorOrAdmin || (selectedApproval.requester_id === principal.principal_id && !principal.roles.includes('runtime_admin'))}\n                    className=\"lara-button lara-button--secondary\"\n                    style={{ borderColor: 'var(--lara-ink)', color: 'var(--lara-ink)' }}\n                  >\n                    <XCircle size={16} />\n                    Reject Action\n                  </button>\n\n                  <button\n                    onClick={() => handleDecision('APPROVE')}\n                    disabled={isDeciding || !isSupervisorOrAdmin || (selectedApproval.requester_id === principal.principal_id && !principal.roles.includes('runtime_admin'))}\n                    className=\"lara-button lara-button--action\"\n                  >\n                    <CheckCircle2 size={16} />\n                    {isDeciding ? 'Recording Decision...' : 'Authorise & Execute Simulated Dispatch'}\n                  </button>\n                </div>\n              </div>\n            ) : (\n              <div\n                style={{\n                  marginTop: '16px',\n                  padding: '14px',\n                  borderRadius: 'var(--lara-radius-sm)',\n                  background: selectedApproval.status === 'APPROVED' ? '#E4F9EE' : '#FFF0EB',\n                  border: selectedApproval.status === 'APPROVED' ? '1px solid #B2F0CF' : '1px solid #FFD2C0',\n                  fontSize: '13px',\n                }}\n              >\n                <strong>Decision Recorded:</strong> {selectedApproval.status}\n                <div>Reason: {selectedApproval.decision_reason}</div>\n                <div style={{ fontSize: '11px', color: 'var(--lara-muted)', marginTop: '4px' }}>\n                  Decided at {selectedApproval.decided_at} by {selectedApproval.decided_by}\n                </div>\n              </div>\n            )}\n          </div>\n        ) : (\n          <div className=\"lara-panel\" style={{ textAlign: 'center', padding: '40px', color: 'var(--lara-muted)' }}>\n            <ClipboardList size={24} style={{ margin: '0 auto 8px', display: 'block' }} />\n            No pending action selected.\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"],"file":"/src/features/approvals/ApprovalQueueView.tsx"}