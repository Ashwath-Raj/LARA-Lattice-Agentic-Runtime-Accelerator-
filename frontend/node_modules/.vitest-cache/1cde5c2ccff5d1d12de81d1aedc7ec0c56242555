ACE,iDAAC,OAAD;SAAK,OAAO;UAAE,SAAS;UAAQ,YAAY;UAAU,KAAK;SAAM;mBAAhE;UACE,iDAAC,UAAD,aAAQ,KAAE,EAAE,OAAgB;;;;;UAC3B,EAAE,YAAY,wBAAwB,kBACrC,iDAAC,QAAD;WAAM,WAAU;WAA+B,OAAO,EAAE,UAAU,OAAO;qBAAG;UAEtE;;;;;UAER,iDAAC,QAAD;WAAM,WAAU;WAAiC,OAAO,EAAE,UAAU,OAAO;qBACxE,EAAE;UACC;;;;;SACH;;;;;kBACL,iDAAC,QAAD;SAAM,OAAO;UAAE,UAAU;UAAQ,OAAO;SAAoB;mBACzD,IAAI,KAAK,EAAE,UAAU,CAAC,CAAC,mBAAmB;QACvC;;;;gBACH;;;;;;OAEL,iDAAC,OAAD;QAAK,OAAO;SAAE,UAAU;SAAQ,OAAO;SAAmB,cAAc;QAAM;kBAC3E,EAAE;OACA;;;;;OAEL,iDAAC,OAAD;QAAK,OAAO;SAAE,UAAU;SAAQ,OAAO;SAAqB,YAAY;QAAY;kBAApF,CAAuF,UAC9E,EAAE,YACN;;;;;;MACF;QAhCE,EAAE;;;;YAgCJ,CACN;IACE;;;;YACF;;;;;;EACF;;;;;CAEJ;;;;;AAET","names":[],"ignoreList":[],"sources":["AgentRegistryView.tsx"],"sourcesContent":["import React, { useState, useEffect } from 'react';\nimport { Agent } from '../../api/types';\nimport { api } from '../../api/client';\nimport { useAuth } from '../auth/AuthContext';\nimport { Cpu, History, X } from 'lucide-react';\n\nexport const AgentRegistryView: React.FC = () => {\n  const { principal, versionChangeNonce } = useAuth();\n  const [agents, setAgents] = useState<Agent[]>([]);\n  const [selectedAgentForHistory, setSelectedAgentForHistory] = useState<Agent | null>(null);\n\n  useEffect(() => {\n    api.getAgents().then((list) => setAgents(list));\n  }, [versionChangeNonce]);\n\n  return (\n    <div>\n      <div className=\"lara-panel\" style={{ marginBottom: '24px' }}>\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n          <div>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n              <span className=\"lara-badge lara-badge--evolution\">AGENT REGISTRY &amp; METADATA</span>\n              <span className=\"lara-badge lara-badge--allow\">3 SPECIALIST AGENTS</span>\n            </div>\n            <h1 style={{ margin: 0, fontSize: '24px', fontWeight: 900 }}>Specialist Agent Fleet</h1>\n            <p style={{ margin: '4px 0 0', fontSize: '14px', color: 'var(--lara-muted)' }}>\n              Orchestrator delegates task scopes exclusively through bounded, verified specialist agents.\n            </p>\n          </div>\n\n          <div>\n            <span className=\"lara-badge lara-badge--neutral\">\n              Session Clearance: {principal.attributes.clearance.toUpperCase()}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Agents Grid */}\n      <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(360px, 1fr))', gap: '20px' }}>\n        {agents.map((agent) => (\n          <div key={agent.agent_id} className=\"lara-panel\" style={{ display: 'flex', flexDirection: 'column' }}>\n            <div style={{ display: 'flex', alignItems: 'flex-start', justifyContent: 'space-between', marginBottom: '14px' }}>\n              <div style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>\n                <div style={{ background: 'var(--lara-lilac)', padding: '10px', borderRadius: '12px' }}>\n                  <Cpu size={22} color=\"var(--lara-ink)\" />\n                </div>\n                <div>\n                  <h3 style={{ margin: 0, fontSize: '18px', fontWeight: 800 }}>{agent.name}</h3>\n                  <span style={{ fontSize: '11px', color: 'var(--lara-muted)' }}><code>{agent.agent_id}</code></span>\n                </div>\n              </div>\n\n              <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'flex-end', gap: '4px' }}>\n                <span className=\"lara-badge lara-badge--allow\" style={{ fontSize: '11px' }}>\n                  ACTIVE V{agent.active_version}\n                </span>\n                <span style={{ fontSize: '10px', color: 'var(--lara-green)', fontWeight: 700 }}>\n                  HEALTHY\n                </span>\n              </div>\n            </div>\n\n            <p style={{ margin: '0 0 16px', fontSize: '13px', color: 'var(--lara-ink)', lineHeight: 1.5, flex: 1 }}>\n              {agent.purpose}\n            </p>\n\n            {/* Skills */}\n            <div style={{ marginBottom: '16px' }}>\n              <div style={{ fontSize: '11px', fontWeight: 800, color: 'var(--lara-muted)', textTransform: 'uppercase', marginBottom: '8px' }}>\n                Active Specialized Skills\n              </div>\n              <div style={{ display: 'flex', flexDirection: 'column', gap: '6px' }}>\n                {agent.skills.map((skill) => (\n                  <div\n                    key={skill.skill_id}\n                    style={{\n                      background: 'var(--lara-surface-subtle)',\n                      padding: '8px 10px',\n                      borderRadius: 'var(--lara-radius-sm)',\n                      border: '1px solid var(--lara-line)',\n                      fontSize: '12px',\n                    }}\n                  >\n                    <div style={{ fontWeight: 700, display: 'flex', justifyContent: 'space-between' }}>\n                      <span>{skill.name}</span>\n                      <span style={{ fontSize: '10px', color: 'var(--lara-muted)' }}>v{skill.version}</span>\n                    </div>\n                    <div style={{ fontSize: '11px', color: 'var(--lara-muted)', marginTop: '2px' }}>\n                      {skill.description}\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Capabilities & Version History CTA */}\n            <div\n              style={{\n                display: 'flex',\n                alignItems: 'center',\n                justifyContent: 'space-between',\n                paddingTop: '12px',\n                borderTop: '1px solid var(--lara-line)',\n                fontSize: '12px',\n              }}\n            >\n              <div style={{ display: 'flex', gap: '4px', flexWrap: 'wrap' }}>\n                {agent.allowed_capabilities.map((cap) => (\n                  <span key={cap} className=\"lara-badge lara-badge--neutral\" style={{ fontSize: '10px' }}>\n                    {cap}\n                  </span>\n                ))}\n              </div>\n\n              <button\n                onClick={() => setSelectedAgentForHistory(agent)}\n                className=\"lara-button lara-button--ghost lara-button--sm\"\n                style={{ fontSize: '12px', color: 'var(--lara-blue)' }}\n              >\n                <History size={13} />\n                Versions ({agent.versions.length})\n              </button>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Version History Modal */}\n      {selectedAgentForHistory && (\n        <div\n          style={{\n            position: 'fixed',\n            top: 0,\n            left: 0,\n            right: 0,\n            bottom: 0,\n            backgroundColor: 'rgba(16, 16, 20, 0.6)',\n            display: 'flex',\n            alignItems: 'center',\n            justifyContent: 'center',\n            zIndex: 200,\n            padding: '20px',\n          }}\n        >\n          <div className=\"lara-panel\" style={{ width: '100%', maxWidth: '580px', maxHeight: '80vh', overflowY: 'auto' }}>\n            <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '16px' }}>\n              <div>\n                <h3 style={{ margin: '0 0 4px', fontSize: '18px', fontWeight: 800 }}>\n                  {selectedAgentForHistory.name} — Version History\n                </h3>\n                <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n                  All version modifications are signed with parent hash and immutable.\n                </div>\n              </div>\n              <button\n                onClick={() => setSelectedAgentForHistory(null)}\n                className=\"lara-button lara-button--ghost\"\n                style={{ padding: '6px' }}\n              >\n                <X size={18} />\n              </button>\n            </div>\n\n            <div style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>\n              {selectedAgentForHistory.versions.map((v) => (\n                <div\n                  key={v.version}\n                  style={{\n                    padding: '12px',\n                    borderRadius: 'var(--lara-radius-sm)',\n                    background: v.version === selectedAgentForHistory.active_version ? 'var(--lara-surface-subtle)' : '#FFFFFF',\n                    border: '1px solid var(--lara-line)',\n                  }}\n                >\n                  <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '6px' }}>\n                    <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n                      <strong>v{v.version}</strong>\n                      {v.version === selectedAgentForHistory.active_version && (\n                        <span className=\"lara-badge lara-badge--allow\" style={{ fontSize: '10px' }}>\n                          ACTIVE\n                        </span>\n                      )}\n                      <span className=\"lara-badge lara-badge--neutral\" style={{ fontSize: '10px' }}>\n                        {v.status}\n                      </span>\n                    </div>\n                    <span style={{ fontSize: '11px', color: 'var(--lara-muted)' }}>\n                      {new Date(v.created_at).toLocaleDateString()}\n                    </span>\n                  </div>\n\n                  <div style={{ fontSize: '12px', color: 'var(--lara-ink)', marginBottom: '6px' }}>\n                    {v.change_summary}\n                  </div>\n\n                  <div style={{ fontSize: '10px', color: 'var(--lara-muted)', fontFamily: 'monospace' }}>\n                    Hash: {v.content_hash}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"],"file":"/src/features/agents/AgentRegistryView.tsx"}