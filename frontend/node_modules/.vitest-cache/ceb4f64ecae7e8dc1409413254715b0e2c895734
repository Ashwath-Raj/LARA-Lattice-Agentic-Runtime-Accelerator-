;QACd,YAAY;QACZ,UAAU;QACV,YAAY;QACZ,OAAO;QACP,WAAW;OACb;iBAEC,KAAK,UAAU,GAAG,SAAS,MAAM,CAAC;MAChC;;;;;KAEJ;OA1CE,GAAG;;;;WA0CL,CACN,GAEA,eAAe,WAAW,KACzB,iDAAC,OAAD;KAAK,OAAO;MAAE,WAAW;MAAU,SAAS;MAAQ,OAAO;KAAoB;eAAG;IAE7E;;;;YAEJ;;;;;;EACF;;;;;CACF;;;;;AAET","names":[],"ignoreList":[],"sources":["AuditTrailView.tsx"],"sourcesContent":["import React, { useState, useEffect } from 'react';\nimport { AuditEvent } from '../../api/types';\nimport { api } from '../../api/client';\nimport { useAuth } from '../auth/AuthContext';\nimport { History, Shield, Filter, Database } from 'lucide-react';\n\nexport const AuditTrailView: React.FC = () => {\n  const { versionChangeNonce } = useAuth();\n  const [events, setEvents] = useState<AuditEvent[]>([]);\n  const [filterType, setFilterType] = useState<string>('ALL');\n  const [filterPrincipal, setFilterPrincipal] = useState<string>('ALL');\n\n  useEffect(() => {\n    api.getAuditEvents().then((list) => setEvents(list));\n  }, [versionChangeNonce]);\n\n  const filteredEvents = events.filter((ev) => {\n    if (filterType !== 'ALL' && ev.event_type !== filterType) return false;\n    if (filterPrincipal !== 'ALL' && ev.principal_id !== filterPrincipal) return false;\n    return true;\n  });\n\n  const getEventBadge = (type: string) => {\n    switch (type) {\n      case 'TASK_CREATED':\n        return <span className=\"lara-badge lara-badge--routing\">TASK CREATED</span>;\n      case 'ROUTE_RESOLVED':\n        return <span className=\"lara-badge lara-badge--routing\">ROUTE RESOLVED</span>;\n      case 'AGENT_DELEGATED':\n        return <span className=\"lara-badge lara-badge--evolution\">AGENT DELEGATED</span>;\n      case 'MODEL_CALLED':\n        return <span className=\"lara-badge lara-badge--allow\">MODEL CALLED</span>;\n      case 'POLICY_DECISION':\n        return <span className=\"lara-badge lara-badge--authority\">POLICY DECISION</span>;\n      case 'APPROVAL_GRANTED':\n        return <span className=\"lara-badge lara-badge--allow\">APPROVAL GRANTED</span>;\n      case 'APPROVAL_REJECTED':\n        return <span className=\"lara-badge lara-badge--deny\">APPROVAL REJECTED</span>;\n      case 'EVOLUTION_PROMOTED':\n        return <span className=\"lara-badge lara-badge--evolution\">EVOLUTION PROMOTED</span>;\n      default:\n        return <span className=\"lara-badge lara-badge--neutral\">{type}</span>;\n    }\n  };\n\n  return (\n    <div>\n      <div className=\"lara-panel\" style={{ marginBottom: '24px' }}>\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', flexWrap: 'wrap', gap: '16px' }}>\n          <div>\n            <div style={{ display: 'flex', alignItems: 'center', gap: '8px', marginBottom: '6px' }}>\n              <span className=\"lara-badge lara-badge--neutral\">\n                <Shield size={12} /> IMMUTABLE AUDIT TRAIL\n              </span>\n              <span className=\"lara-badge lara-badge--allow\">PERSISTED</span>\n            </div>\n            <h1 style={{ margin: 0, fontSize: '24px', fontWeight: 900 }}>Cryptographic Audit &amp; Provenance</h1>\n            <p style={{ margin: '4px 0 0', fontSize: '14px', color: 'var(--lara-muted)' }}>\n              Full operational log of dynamic routes, source accesses, Vertex AI inferences, policy gates, and human approvals.\n            </p>\n          </div>\n\n          <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n            Total Events: <strong>{events.length}</strong>\n          </div>\n        </div>\n      </div>\n\n      {/* Filters Bar */}\n      <div\n        className=\"lara-panel lara-panel--sm\"\n        style={{\n          marginBottom: '20px',\n          display: 'flex',\n          alignItems: 'center',\n          gap: '16px',\n          flexWrap: 'wrap',\n          background: 'var(--lara-surface-subtle)',\n        }}\n      >\n        <div style={{ display: 'flex', alignItems: 'center', gap: '6px', fontSize: '13px', fontWeight: 700 }}>\n          <Filter size={16} /> Filters:\n        </div>\n\n        <div>\n          <select\n            className=\"lara-select\"\n            value={filterType}\n            onChange={(e) => setFilterType(e.target.value)}\n            style={{ padding: '6px 12px', fontSize: '12px' }}\n          >\n            <option value=\"ALL\">All Event Types</option>\n            <option value=\"TASK_CREATED\">Task Created</option>\n            <option value=\"ROUTE_RESOLVED\">Route Resolved</option>\n            <option value=\"AGENT_DELEGATED\">Agent Delegated</option>\n            <option value=\"MODEL_CALLED\">Model Called</option>\n            <option value=\"POLICY_DECISION\">Policy Decision</option>\n            <option value=\"APPROVAL_GRANTED\">Approval Granted</option>\n            <option value=\"APPROVAL_REJECTED\">Approval Rejected</option>\n            <option value=\"EVOLUTION_PROMOTED\">Evolution Promoted</option>\n          </select>\n        </div>\n\n        <div>\n          <select\n            className=\"lara-select\"\n            value={filterPrincipal}\n            onChange={(e) => setFilterPrincipal(e.target.value)}\n            style={{ padding: '6px 12px', fontSize: '12px' }}\n          >\n            <option value=\"ALL\">All Principals</option>\n            <option value=\"usr_operator_01\">Maya Operator (usr_operator_01)</option>\n            <option value=\"usr_supervisor_01\">Ravi Supervisor (usr_supervisor_01)</option>\n            <option value=\"usr_admin_01\">LARA Administrator (usr_admin_01)</option>\n            <option value=\"usr_auditor_01\">Nila Auditor (usr_auditor_01)</option>\n          </select>\n        </div>\n      </div>\n\n      {/* Event Stream */}\n      <div className=\"lara-panel\">\n        <div style={{ display: 'flex', flexDirection: 'column', gap: '12px' }}>\n          {filteredEvents.map((ev) => (\n            <div\n              key={ev.event_id}\n              style={{\n                padding: '14px 16px',\n                borderRadius: 'var(--lara-radius-sm)',\n                border: '1px solid var(--lara-line)',\n                background: '#FFFFFF',\n              }}\n            >\n              <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '8px' }}>\n                <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>\n                  {getEventBadge(ev.event_type)}\n                  <strong style={{ fontSize: '14px' }}>{ev.action}</strong>\n                </div>\n\n                <div style={{ fontSize: '12px', color: 'var(--lara-muted)' }}>\n                  {new Date(ev.timestamp).toLocaleTimeString()} &bull; {new Date(ev.timestamp).toLocaleDateString()}\n                </div>\n              </div>\n\n              <div style={{ display: 'flex', alignItems: 'center', gap: '14px', fontSize: '11px', color: 'var(--lara-muted)', marginBottom: '8px' }}>\n                <span>Event ID: <code>{ev.event_id}</code></span>\n                <span>Trace ID: <code>{ev.trace_id}</code></span>\n                <span>Principal: <strong>{ev.principal_id}</strong></span>\n                {ev.task_id && <span>Task: <code>{ev.task_id}</code></span>}\n              </div>\n\n              {ev.details && Object.keys(ev.details).length > 0 && (\n                <pre\n                  style={{\n                    margin: 0,\n                    padding: '8px 12px',\n                    borderRadius: '6px',\n                    background: 'var(--lara-surface-subtle)',\n                    fontSize: '11px',\n                    fontFamily: 'var(--lara-font-mono)',\n                    color: 'var(--lara-ink)',\n                    overflowX: 'auto',\n                  }}\n                >\n                  {JSON.stringify(ev.details, null, 2)}\n                </pre>\n              )}\n            </div>\n          ))}\n\n          {filteredEvents.length === 0 && (\n            <div style={{ textAlign: 'center', padding: '40px', color: 'var(--lara-muted)' }}>\n              No audit events matched the filter.\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n"],"file":"/src/features/audit/AuditTrailView.tsx"}