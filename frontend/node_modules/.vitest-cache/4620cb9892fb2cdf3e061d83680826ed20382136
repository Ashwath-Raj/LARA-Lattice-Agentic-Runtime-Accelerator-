if (!isOpen) return null;\n\n  const handleFillDemoScenario = () => {\n    setTitle('Investigate incident INC-204 (Centrifugal Pump P-204)');\n    setPrompt(\n      'Investigate the repeated vibration and temperature anomaly for centrifugal pump P-204. Prepare an evidence-backed diagnostic response and submit a simulated maintenance request if justified by current SOPs.'\n    );\n    setIncidentId('INC-204');\n    setError(null);\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!prompt.trim() || prompt.length < 10) {\n      setError('Please provide an investigation prompt of at least 10 characters.');\n      return;\n    }\n    setError(null);\n    try {\n      await onSubmit({\n        title: title.trim() || `Investigate ${incidentId}`,\n        prompt: prompt.trim(),\n        incident_id: incidentId,\n        attachment_ids: [],\n      });\n      onClose();\n    } catch (err: unknown) {\n      setError(err instanceof Error ? err.message : 'Failed to submit task');\n    }\n  };\n\n  return (\n    <div\n      style={{\n        position: 'fixed',\n        top: 0,\n        left: 0,\n        right: 0,\n        bottom: 0,\n        backgroundColor: 'rgba(16, 16, 20, 0.6)',\n        display: 'flex',\n        alignItems: 'center',\n        justifyContent: 'center',\n        zIndex: 200,\n        padding: '20px',\n      }}\n    >\n      <div\n        className=\"lara-panel\"\n        style={{\n          width: '100%',\n          maxWidth: '680px',\n          maxHeight: '90vh',\n          overflowY: 'auto',\n          position: 'relative',\n        }}\n      >\n        <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'space-between', marginBottom: '20px' }}>\n          <div>\n            <h2 style={{ margin: '0 0 4px', fontSize: '20px', fontWeight: 800 }}>Start Incident Investigation</h2>\n            <div style={{ fontSize: '13px', color: 'var(--lara-muted)' }}>\n              LARA resolves authorised Information Highways and delegates to specialist agents.\n            </div>\n          </div>\n          <button onClick={onClose} className=\"lara-button lara-button--ghost\" style={{ padding: '6px' }}>\n            <X size={20} />\n          </button>\n        </div>\n\n        {/* Demo prefill helper */}\n        <div\n          style={{\n            background: 'var(--lara-surface-subtle)',\n            border: '1px solid var(--lara-line)',\n            borderRadius: 'var(--lara-radius-sm)',\n            padding: '12px 16px',\n            display: 'flex',\n            alignItems: 'center',\n            justifyContent: 'space-between',\n            marginBottom: '20px',\n          }}\n        >\n          <div style={{ fontSize: '13px' }}>\n            <strong>Demo Scenario:</strong> Repeated vibration and temperature spike on pump P-204.\n          </div>\n          <button\n            type=\"button\"\n            onClick={handleFillDemoScenario}\n            className=\"lara-button lara-button--sm lara-button--secondary\"\n            style={{ fontSize: '12px' }}\n          >\n            <Sparkles size={14} color=\"var(--lara-violet)\" />\n            Load Pre-filled Demo Prompt\n          </button>\n        </div>\n\n        {error && (\n          <div\n            style={{\n              background: '#FFF0EB',\n              border: '1px solid #FFD2C0',\n              color: '#B53A0A',\n              padding: '12px',\n              borderRadius: 'var(--lara-radius-sm)',\n              marginBottom: '16px',\n              display: 'flex',\n              alignItems: 'center',\n              gap: '8px',\n              fontSize: '13px',\n            }}\n          >\n            <AlertCircle size={16} />\n            {error}\n          </div>\n        )}\n\n        <form onSubmit={handleSubmit}>\n          <div style={{ marginBottom: '16px' }}>\n            <label className=\"lara-label\">Investigation Title (Optional)</label>\n            <input\n              type=\"text\"\n              className=\"lara-input\"\n              placeholder=\"e.g. Investigate incident INC-204\"\n              value={title}\n              onChange={(e) => setTitle(e.target.value)}\n              disabled={isSubmitting}\n            />\n          </div>\n\n          <div style={{ display: 'grid', gridTemplateColumns: '1fr 1fr', gap: '16px', marginBottom: '16px' }}>\n            <div>\n              <label className=\"lara-label\">Incident ID Selector</label>\n              <select\n                className=\"lara-select\"\n                value={incidentId}\n                onChange={(e) => setIncidentId(e.target.value)}\n                disabled={isSubmitting}\n              >\n                <option value=\"INC-204\">INC-204 (Centrifugal Pump P-204 Anomaly)</option>\n                <option value=\"INC-189\">INC-189 (Heat Exchanger HX-12 Leak)</option>\n                <option value=\"INC-102\">INC-102 (Boiler Feed Valve VF-01 Jam)</option>\n              </select>\n            </div>\n            <div>\n              <label className=\"lara-label\">Synthetic Target Asset</label>\n              <input\n                type=\"text\"\n                className=\"lara-input\"\n                value={incidentId === 'INC-204' ? 'P-204 (Apex-3000 Series Pump)' : 'General Plant Alpha Unit'}\n                readOnly\n                style={{ background: '#F8FAF2', color: 'var(--lara-muted)' }}\n              />\n            </div>\n          </div>\n\n          <div style={{ marginBottom: '24px' }}>\n            <label className=\"lara-label\">Task Prompt &amp; Scope Requirements *</label>\n            <textarea\n              className=\"lara-textarea\"\n              rows={4}\n              placeholder=\"Describe the incident investigation requirements, required evidence sources, and response instructions...\"\n              value={prompt}\n              onChange={(e) => setPrompt(e.target.value)}\n              disabled={isSubmitting}\n              required\n            />\n            <div style={{ fontSize: '11px', color: 'var(--lara-muted)', marginTop: '4px' }}>\n              Min 10 characters. Server will derive principal and resolve permitted Information Highway routes.\n            </div>\n          </div>\n\n          <div style={{ display: 'flex', alignItems: 'center', justifyContent: 'flex-end', gap: '12px' }}>\n            <button\n              type=\"button\"\n              onClick={onClose}\n              disabled={isSubmitting}\n              className=\"lara-button lara-button--secondary\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              disabled={isSubmitting || !prompt.trim()}\n              className=\"lara-button lara-button--primary\"\n            >\n              {isSubmitting ? 'Routing & Delegating...' : 'Submit Investigation Task'}\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"],"file":"/src/features/workbench/NewTaskModal.tsx"}